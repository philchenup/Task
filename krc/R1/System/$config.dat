SIGNAL RG_E6 $OUT[3889]  TO $OUT[3920]

; Task ack  $OUT[3921]..$OUT[4032]
; TC_TASK_STATE 0 idle, 1 ready, 2 welding, 3 done, 4 error (see pc2kuka.src)
; TC_ERR_CODE   1 task not set, 2 missing data, 3 tool/base, 4 arc timeout,
;               5 aborted, 6 unknown command, 8 enable off, 9 bad weave
SIGNAL TC_ACK_CMD $OUT[3921]  TO $OUT[3928]
SIGNAL TC_TASK_STATE $OUT[3937]  TO $OUT[3944]
SIGNAL TC_ERR_CODE $OUT[3945]  TO $OUT[3952]
SIGNAL TC_ACK_TASK_ID $OUT[3953]  TO $OUT[3968]
SIGNAL TC_ACK_TOGGLE $OUT[3993]
SIGNAL TC_TASK_BUSY $OUT[3994]
SIGNAL TC_ARC_ON $OUT[3995]
SIGNAL TC_ACK_FRAME_NO $OUT[4001]  TO $OUT[4016]
SIGNAL TC_PROGRESS $OUT[4017]  TO $OUT[4032]
; $OUT[4033]..$OUT[4048] spare

