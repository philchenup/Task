;==================================
; Userdefined robot weld comm
;==================================
; IN and OUT both start at 3025. Low signal number is the LSB.
; 32 bit fields are IEEE754 binary32. A SIGNAL is an integer view of those
; bits, so src converts them with BitsToReal / RealToBits.
;
; 3025..4048 is 128 bytes. The header is 16 bytes and the payload is the
; other 112. RS_CMD says which reading of the payload is valid. The other
; names are aliases of the same bits and are not written by the robot.
;
;   RS_CMD 1  realtime joint     one A1..A6 E1..E3 target and dynamics
;   RS_CMD 2  joint trajectory   same bits as command 1, one waypoint
;   RS_CMD 3  weld points        4 endpoints X..C and 4 corner distances
;   RS_CMD 4  Cartesian stream   X..C E1..E3 S T, path speed, acc, ori
;   RS_CMD 5  weld process       up to 4 seam processes and task params
;   RS_CMD 6  execute the latched weld
;   RS_CMD 7  clear the weld buffer
;
; Command 3 is one transfer. Four XYZABC poses are 96 bytes and four
; corner distances are 16 bytes, which fills the payload. E1..E3 and S/T
; are not in this image; pc2kuka.src copies them from the actual pose,
; so the positioner stays where it is. A corner distance is millimetres
; and is applied on both sides of that vertex.
;
; RS_CLOSED = 0 is an open chain: seams = point count - 1. Four points
; are then 3 seams, and the distances on the two end points are ignored.
; RS_CLOSED = 1 is a closed chain: seams = point count. Four points are
; then 4 head-to-tail seams, and the last seam runs from point 4 to
; point 1. A closed chain needs at least 3 points.
;
; Command 2 is the joint-waypoint stream. Command 1 is the single live
; joint target. Both read RJ_*. Command 4 keeps the Cartesian stream
; that used to be command 2.
;
; The PC writes the whole 128 bytes in one transfer and flips RS_TOGGLE
; in that same transfer. The robot latches on the edge. RS_CONT requests
; approximation, which is what a 50 ms stream needs in order to keep
; moving. RS_ENABLE, RS_RESET and RS_GOTO_HOME are acted on outside the
; weld pages. RS_PC_ALIVE is the PC watchdog. RS_ABORT stops the motion.
; RS_ARC_TRACK is reserved for the laser inputs at $IN[2169].
;
; Byte 0 of this image is $IN[3025]. If byte 0 of the Profinet image is
; $IN[1], the cifX offset is (3025-1)/8 = 378.
; Welder commands are not in this image. They stay on PLC_EWM_* at
; $IN[2001], cifX offset 250.

;DEFINE IN IO
; Header  $IN[3025]..$IN[3152], 16 bytes. Valid for every command.
SIGNAL RS_CMD $IN[3025]  TO $IN[3032]
SIGNAL RS_TOOL_ID $IN[3033]  TO $IN[3040]
SIGNAL RS_BASE_ID $IN[3041]  TO $IN[3048]
SIGNAL RS_ENABLE $IN[3049]
SIGNAL RS_PC_ALIVE $IN[3050]
SIGNAL RS_RESET $IN[3051]
SIGNAL RS_GOTO_HOME $IN[3052]
SIGNAL RS_ABORT $IN[3053]
SIGNAL RS_TOGGLE $IN[3054]
; $IN[3055]..$IN[3056] reserved
SIGNAL RS_TASK_ID $IN[3057]  TO $IN[3072]
; $IN[3073]..$IN[3088] reserved
SIGNAL RS_FRAME_NO $IN[3089]  TO $IN[3104]
; $IN[3105]..$IN[3152] unused so the payload stays on a 16 byte boundary

; Payload aliases, $IN[3153]..$IN[4048]. Read only the group selected by RS_CMD.

; RS_CMD 1  joint target, speed and acceleration in percent 1..100.
SIGNAL RJ_A1 $IN[3153]  TO $IN[3184]
SIGNAL RJ_A2 $IN[3185]  TO $IN[3216]
SIGNAL RJ_A3 $IN[3217]  TO $IN[3248]
SIGNAL RJ_A4 $IN[3249]  TO $IN[3280]
SIGNAL RJ_A5 $IN[3281]  TO $IN[3312]
SIGNAL RJ_A6 $IN[3313]  TO $IN[3344]
SIGNAL RJ_E1 $IN[3345]  TO $IN[3376]
SIGNAL RJ_E2 $IN[3377]  TO $IN[3408]
SIGNAL RJ_E3 $IN[3409]  TO $IN[3440]
SIGNAL RJ_AXIS_SPEED $IN[3441]  TO $IN[3472]
SIGNAL RJ_AXIS_ACC $IN[3473]  TO $IN[3504]
SIGNAL RJ_EXT_SPEED $IN[3505]  TO $IN[3536]
SIGNAL RJ_EXT_ACC $IN[3537]  TO $IN[3568]

; RS_CMD 2  two weld endpoints (mm/deg) and one process block.
SIGNAL WS_P1_X $IN[3153]  TO $IN[3184]
SIGNAL WS_P1_Y $IN[3185]  TO $IN[3216]
SIGNAL WS_P1_Z $IN[3217]  TO $IN[3248]
SIGNAL WS_P1_A $IN[3249]  TO $IN[3280]
SIGNAL WS_P1_B $IN[3281]  TO $IN[3312]
SIGNAL WS_P1_C $IN[3313]  TO $IN[3344]
SIGNAL WS_P2_X $IN[3345]  TO $IN[3376]
SIGNAL WS_P2_Y $IN[3377]  TO $IN[3408]
SIGNAL WS_P2_Z $IN[3409]  TO $IN[3440]
SIGNAL WS_P2_A $IN[3441]  TO $IN[3472]
SIGNAL WS_P2_B $IN[3473]  TO $IN[3504]
SIGNAL WS_P2_C $IN[3505]  TO $IN[3536]
SIGNAL WS_SPEED $IN[3537]  TO $IN[3568]
SIGNAL WS_AMP $IN[3569]  TO $IN[3600]
SIGNAL WS_FREQ $IN[3601]  TO $IN[3632]
SIGNAL WS_WEAVE $IN[3633]  TO $IN[3640]
SIGNAL WS_JOB $IN[3641]  TO $IN[3648]
SIGNAL WS_WIRE $IN[3649]  TO $IN[3664]
SIGNAL WS_VOLT $IN[3665]  TO $IN[3680]
SIGNAL WS_DYN $IN[3681]  TO $IN[3696]
SIGNAL WS_CRATER $IN[3697]  TO $IN[3728]
SIGNAL WS_APPROACH $IN[3729]  TO $IN[3760]
SIGNAL WS_AIRSPEED $IN[3761]  TO $IN[3792]
SIGNAL WS_AXSPEED $IN[3793]  TO $IN[3824]
SIGNAL WS_AXACC $IN[3825]  TO $IN[3856]
SIGNAL WS_EXSPEED $IN[3857]  TO $IN[3888]
SIGNAL WS_EXACC $IN[3889]  TO $IN[3920]
SIGNAL WS_SAMPLES $IN[3921]  TO $IN[3928]
; $IN[3929]..$IN[4048] spare for RS_CMD 2

;DEFINE OUT IO
; Robot feedback  $OUT[3025]..$OUT[3632]
SIGNAL RG_AXIS_VEL $OUT[3025]  TO $OUT[3056]
SIGNAL RG_AXIS_ACC $OUT[3057]  TO $OUT[3088]
SIGNAL RG_EXT_AXIS_VEL $OUT[3089]  TO $OUT[3120]
SIGNAL RG_EXT_AXIS_ACC $OUT[3121]  TO $OUT[3152]
SIGNAL RG_E1 $OUT[3153]  TO $OUT[3184]
SIGNAL RG_E2 $OUT[3185]  TO $OUT[3216]
SIGNAL RG_E3 $OUT[3217]  TO $OUT[3248]
SIGNAL RG_SJ1 $OUT[3249]  TO $OUT[3280]
SIGNAL RG_SJ2 $OUT[3281]  TO $OUT[3312]
SIGNAL RG_SJ3 $OUT[3313]  TO $OUT[3344]
SIGNAL RG_SJ4 $OUT[3345]  TO $OUT[3376]
SIGNAL RG_SJ5 $OUT[3377]  TO $OUT[3408]
