SIGNAL WG_REAL_WIRE_SPEED $OUT[3679]  TO $OUT[3694]

; Controller status  $OUT[3697]..$OUT[3920]
SIGNAL RG_ACT_TOOL $OUT[3713]  TO $OUT[3720]
