&ACCESS RV
&REL 4
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF pc2kuka( )

  ; One Profinet image, $IN[3025]..$IN[4048], shared by three jobs.
  ; RS_CMD selects the reading. The robot latches on every RS_TOGGLE edge.
  ;
  ;   1 joint stream, A1..A6 E1..E3 and the percent dynamics
  ;   2 Cartesian stream, X..C E1..E3 S T and the path dynamics
  ;   3 weld endpoints 1 and 2, plus the corner at point 2
  ;   4 weld endpoints 3 and 4, plus the corner at point 3
  ;   5 up to 3 seam processes and the task parameters
  ;   6 weld the latched chain
  ;   7 clear the buffer
  ;
  ; A chain has 1..4 endpoints and therefore 0..3 straight seams. Page 3
  ; carries one process per seam. WEAVE 1 is a triangle and WEAVE 2 is a
  ; sine, both interpolated here with LIN. RS_CONT blends a stream so the
  ; arm does not stop on every 50 ms sample. This is interpreter streaming,
  ; not an RSI overlay: the PC waits for TC_ACK_TOGGLE before the next edge
  ; if every sample has to be executed.
  ;
  ; RS_RESET and RS_GOTO_HOME are pulses and are handled before RS_CMD.
  ; RS_ABORT brakes the motion from any line. This program never writes
  ; EWM_*. It uses $TIMER[21]. sps.sub uses $TIMER[20] and $TIMER[22].

  DECL INT nCmd

  BAS(#INITMOV,0)
  $APO.CDIS = 0.0
  $APO.CPTP = 0
  $ADVANCE = 3

  WT_TASK_ID = 0
  WT_NSEAM = 0
  WT_NPT = 0
  WT_TOOL = 1
  WT_BASE = 0
  WT_ERR = 0
  WT_SAMPLES = 0
  WT_ARC_TRACK = FALSE
  WT_ABORTED = FALSE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  ClearTask()

  TC_ACK_CMD = 0
  TC_ACK_TASK_ID = 0
  TC_ACK_POINT_COUNT = 0
  TC_ACK_FRAME_NO = 0
  TC_TASK_STATE = 0
  TC_ERR_CODE = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
  TC_TASK_BUSY = FALSE
  TC_ARC_ON = FALSE
  TC_ACK_TOGGLE = RS_TOGGLE

  INTERRUPT DECL 25 WHEN RS_ABORT==TRUE DO TaskAbort()
  INTERRUPT ON 25

  LOOP
    IF WT_ABORTED THEN
      WAIT FOR NOT(RS_ABORT)
      WT_ABORTED = FALSE
      INTERRUPT ON 25
    ENDIF

    WAIT FOR (RS_TOGGLE <> TC_ACK_TOGGLE) OR RS_RESET OR RS_GOTO_HOME
    IF WT_ABORTED THEN
      CONTINUE
    ENDIF

    IF RS_RESET THEN
      WT_ERR = 0
      TC_ERR_CODE = 0
      IF TC_TASK_STATE == 5 THEN
        TC_TASK_STATE = 0
      ENDIF
      WAIT FOR NOT(RS_RESET)
      CONTINUE
    ENDIF

    IF RS_GOTO_HOME THEN
      GoHome()
      WAIT FOR NOT(RS_GOTO_HOME)
      CONTINUE
    ENDIF

    nCmd = RS_CMD
    SWITCH nCmd
    CASE 1
      JointMove()
    CASE 2
      CartMove()
    CASE 3
      ReadPoints(1)
    CASE 4
      ReadPoints(2)
    CASE 5
      ReadProcess()
    CASE 6
      TaskExec()
    CASE 7
      ClearTask()
      WT_TASK_ID = 0
      WT_NPT = 0
      WT_NSEAM = 0
      WT_ERR = 0
      TC_ERR_CODE = 0
      TC_TASK_STATE = 0
    DEFAULT
      WT_ERR = 6
      TC_ERR_CODE = 6
      TC_TASK_STATE = 5
    ENDSWITCH

    TC_ACK_CMD = nCmd
    TC_ACK_TASK_ID = WT_TASK_ID
    TC_ACK_POINT_COUNT = WT_NPT
    TC_ACK_FRAME_NO = RS_FRAME_NO
    TC_ACK_TOGGLE = RS_TOGGLE
  ENDLOOP

END

;==================================
; Buffer
;==================================

DEF ClearTask()
  DECL INT i

  FOR i = 1 TO WT_MAXPT
    WT_PT[i].PVALID = FALSE
    WT_PT[i].CPRE = 0.0
    WT_PT[i].CPOST = 0.0
    WT_PT[i].CROT = 0.0
    WT_PT[i].CDWELL = 0.0
  ENDFOR
  FOR i = 1 TO WT_MAXPT - 1
    WT_SEG[i].SVALID = FALSE
    WT_SEG[i].SPEED = 0.0
    WT_SEG[i].AMP = 0.0
    WT_SEG[i].FREQ = 0.0
    WT_SEG[i].WEAVE = 0
    WT_SEG[i].JOB = 0
    WT_SEG[i].WIRE = 0
    WT_SEG[i].VOLT = 0
    WT_SEG[i].DYN = 0
  ENDFOR
  WT_SAMPLES = 0
  TC_PAGE_MASK = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
END

DEF NewTask()
  ; page 1 opens the task and drops anything latched before it
  WT_TASK_ID = RS_TASK_ID
  WT_NPT = RS_POINT_COUNT
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  WT_ARC_TRACK = RS_ARC_TRACK
  WT_ERR = 0
  ClearTask()
  IF (WT_NPT < 1) OR (WT_NPT > WT_MAXPT) THEN
    WT_NSEAM = 0
    WT_ERR = 1
    TC_ERR_CODE = 1
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_NSEAM = WT_NPT - 1
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

DEF NeedPage1()
  IF (TC_PAGE_MASK B_AND 1) <> 1 THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  IF RS_TASK_ID <> WT_TASK_ID THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_ERR = 0
END

DEF ReadPoints(nPage:IN)
  DECL INT nPage

  IF nPage == 1 THEN
    NewTask()
    IF WT_ERR <> 0 THEN
      RETURN
    ENDIF
    WT_PT[1].P.X = BitsToReal(WP1_X)
    WT_PT[1].P.Y = BitsToReal(WP1_Y)
    WT_PT[1].P.Z = BitsToReal(WP1_Z)
    WT_PT[1].P.A = BitsToReal(WP1_A)
    WT_PT[1].P.B = BitsToReal(WP1_B)
    WT_PT[1].P.C = BitsToReal(WP1_C)
    WT_PT[1].P.E1 = BitsToReal(WP1_E1)
    WT_PT[1].P.E2 = BitsToReal(WP1_E2)
    WT_PT[1].P.E3 = BitsToReal(WP1_E3)
    WT_PT[1].P.E4 = $AXIS_ACT.E4
    WT_PT[1].P.E5 = $AXIS_ACT.E5
    WT_PT[1].P.E6 = $AXIS_ACT.E6
    WT_PT[1].P.S = WP1_S
    WT_PT[1].P.T = WP1_T
    WT_PT[1].PVALID = TRUE
    IF WT_NPT >= 2 THEN
      WT_PT[2].P.X = BitsToReal(WP2_X)
      WT_PT[2].P.Y = BitsToReal(WP2_Y)
      WT_PT[2].P.Z = BitsToReal(WP2_Z)
      WT_PT[2].P.A = BitsToReal(WP2_A)
      WT_PT[2].P.B = BitsToReal(WP2_B)
      WT_PT[2].P.C = BitsToReal(WP2_C)
      WT_PT[2].P.E1 = BitsToReal(WP2_E1)
      WT_PT[2].P.E2 = BitsToReal(WP2_E2)
      WT_PT[2].P.E3 = BitsToReal(WP2_E3)
      WT_PT[2].P.E4 = $AXIS_ACT.E4
      WT_PT[2].P.E5 = $AXIS_ACT.E5
      WT_PT[2].P.E6 = $AXIS_ACT.E6
      WT_PT[2].P.S = WP2_S
      WT_PT[2].P.T = WP2_T
      WT_PT[2].PVALID = TRUE
    ENDIF
    IF WT_NPT >= 3 THEN
      WT_PT[2].CPRE = BitsToReal(WC2_PRE)
      WT_PT[2].CPOST = BitsToReal(WC2_POST)
      WT_PT[2].CROT = BitsToReal(WC2_ROT)
      WT_PT[2].CDWELL = WC2_DWELL / 100.0
    ENDIF
    TC_PAGE_MASK = TC_PAGE_MASK B_OR 1
    TC_ERR_CODE = 0
    TC_TASK_STATE = 1
    RETURN
  ENDIF

  NeedPage1()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF WT_NPT >= 3 THEN
    WT_PT[3].P.X = BitsToReal(WP3_X)
    WT_PT[3].P.Y = BitsToReal(WP3_Y)
    WT_PT[3].P.Z = BitsToReal(WP3_Z)
    WT_PT[3].P.A = BitsToReal(WP3_A)
    WT_PT[3].P.B = BitsToReal(WP3_B)
    WT_PT[3].P.C = BitsToReal(WP3_C)
    WT_PT[3].P.E1 = BitsToReal(WP3_E1)
    WT_PT[3].P.E2 = BitsToReal(WP3_E2)
    WT_PT[3].P.E3 = BitsToReal(WP3_E3)
    WT_PT[3].P.E4 = $AXIS_ACT.E4
    WT_PT[3].P.E5 = $AXIS_ACT.E5
    WT_PT[3].P.E6 = $AXIS_ACT.E6
    WT_PT[3].P.S = WP3_S
    WT_PT[3].P.T = WP3_T
    WT_PT[3].PVALID = TRUE
  ENDIF
  IF WT_NPT >= 4 THEN
    WT_PT[4].P.X = BitsToReal(WP4_X)
    WT_PT[4].P.Y = BitsToReal(WP4_Y)
    WT_PT[4].P.Z = BitsToReal(WP4_Z)
    WT_PT[4].P.A = BitsToReal(WP4_A)
    WT_PT[4].P.B = BitsToReal(WP4_B)
    WT_PT[4].P.C = BitsToReal(WP4_C)
    WT_PT[4].P.E1 = BitsToReal(WP4_E1)
    WT_PT[4].P.E2 = BitsToReal(WP4_E2)
    WT_PT[4].P.E3 = BitsToReal(WP4_E3)
    WT_PT[4].P.E4 = $AXIS_ACT.E4
    WT_PT[4].P.E5 = $AXIS_ACT.E5
    WT_PT[4].P.E6 = $AXIS_ACT.E6
    WT_PT[4].P.S = WP4_S
    WT_PT[4].P.T = WP4_T
    WT_PT[4].PVALID = TRUE
    WT_PT[3].CPRE = BitsToReal(WC3_PRE)
    WT_PT[3].CPOST = BitsToReal(WC3_POST)
    WT_PT[3].CROT = BitsToReal(WC3_ROT)
    WT_PT[3].CDWELL = WC3_DWELL / 100.0
  ENDIF
  IF WT_NPT >= 3 THEN
    TC_PAGE_MASK = TC_PAGE_MASK B_OR 2
  ENDIF
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

DEF ReadProcess()
  NeedPage1()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF WT_NSEAM >= 1 THEN
    WT_SEG[1].SPEED = BitsToReal(SG1_SPEED)
    WT_SEG[1].AMP = BitsToReal(SG1_AMP)
    WT_SEG[1].FREQ = BitsToReal(SG1_FREQ)
    WT_SEG[1].WEAVE = SG1_WEAVE
    WT_SEG[1].JOB = SG1_JOB
    WT_SEG[1].WIRE = SG1_WIRE
    WT_SEG[1].VOLT = SG1_VOLT
    WT_SEG[1].DYN = SG1_DYN
    WT_SEG[1].SVALID = TRUE
  ENDIF
  IF WT_NSEAM >= 2 THEN
    WT_SEG[2].SPEED = BitsToReal(SG2_SPEED)
    WT_SEG[2].AMP = BitsToReal(SG2_AMP)
    WT_SEG[2].FREQ = BitsToReal(SG2_FREQ)
    WT_SEG[2].WEAVE = SG2_WEAVE
    WT_SEG[2].JOB = SG2_JOB
    WT_SEG[2].WIRE = SG2_WIRE
    WT_SEG[2].VOLT = SG2_VOLT
    WT_SEG[2].DYN = SG2_DYN
    WT_SEG[2].SVALID = TRUE
  ENDIF
  IF WT_NSEAM >= 3 THEN
    WT_SEG[3].SPEED = BitsToReal(SG3_SPEED)
    WT_SEG[3].AMP = BitsToReal(SG3_AMP)
    WT_SEG[3].FREQ = BitsToReal(SG3_FREQ)
    WT_SEG[3].WEAVE = SG3_WEAVE
    WT_SEG[3].JOB = SG3_JOB
    WT_SEG[3].WIRE = SG3_WIRE
    WT_SEG[3].VOLT = SG3_VOLT
    WT_SEG[3].DYN = SG3_DYN
    WT_SEG[3].SVALID = TRUE
  ENDIF
  WT_CRATER = BitsToReal(TC_CRATER)
  WT_APPROACH = BitsToReal(TC_APPROACH)
  WT_AIRSPEED = BitsToReal(TC_AIRSPEED)
  WT_AXSPEED = BitsToReal(TC_AXSPEED)
  WT_AXACC = BitsToReal(TC_AXACC)
  WT_EXSPEED = BitsToReal(TC_EXSPEED)
  WT_EXACC = BitsToReal(TC_EXACC)
  WT_SAMPLES = TC_SAMPLES
  TC_PAGE_MASK = TC_PAGE_MASK B_OR 4
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

;==================================
; Stream and home
;==================================

DEF ApplyFrame()
  IF (RS_TOOL_ID < 1) OR (RS_TOOL_ID > 16) OR (RS_BASE_ID < 0) OR (RS_BASE_ID > 32) THEN
    WT_ERR = 3
    TC_ERR_CODE = 3
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  WT_ERR = 0
END

DEF RequireEnable()
  IF NOT(RS_ENABLE) THEN
    WT_ERR = 8
    TC_ERR_CODE = 8
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_ERR = 0
END

DEF JointMove()
  DECL E6AXIS aTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  SetJointDyn()
  aTgt.A1 = BitsToReal(RJ_A1)
  aTgt.A2 = BitsToReal(RJ_A2)
  aTgt.A3 = BitsToReal(RJ_A3)
  aTgt.A4 = BitsToReal(RJ_A4)
  aTgt.A5 = BitsToReal(RJ_A5)
  aTgt.A6 = BitsToReal(RJ_A6)
  aTgt.E1 = BitsToReal(RJ_E1)
  aTgt.E2 = BitsToReal(RJ_E2)
  aTgt.E3 = BitsToReal(RJ_E3)
  aTgt.E4 = $AXIS_ACT.E4
  aTgt.E5 = $AXIS_ACT.E5
  aTgt.E6 = $AXIS_ACT.E6
  IF RS_CONT THEN
    $APO.CPTP = 50
    PTP aTgt C_PTP
  ELSE
    $APO.CPTP = 0
    PTP aTgt
  ENDIF
  NoteStream()
END

DEF CartMove()
  DECL E6POS pTgt
  DECL REAL rBlend

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  SetCartDyn()
  pTgt = $POS_ACT
  pTgt.X = BitsToReal(RT_X)
  pTgt.Y = BitsToReal(RT_Y)
  pTgt.Z = BitsToReal(RT_Z)
  pTgt.A = BitsToReal(RT_A)
  pTgt.B = BitsToReal(RT_B)
  pTgt.C = BitsToReal(RT_C)
  pTgt.E1 = BitsToReal(RT_E1)
  pTgt.E2 = BitsToReal(RT_E2)
  pTgt.E3 = BitsToReal(RT_E3)
  pTgt.E4 = $AXIS_ACT.E4
  pTgt.E5 = $AXIS_ACT.E5
  pTgt.E6 = $AXIS_ACT.E6
  pTgt.S = RT_S
  pTgt.T = RT_T
  IF RS_CONT THEN
    ; about one 50 ms sample of travel, so consecutive targets blend
    rBlend = BitsToReal(RT_SPEED) * 0.05
    IF rBlend < 1.0 THEN
      rBlend = 1.0
    ENDIF
    IF rBlend > 50.0 THEN
      rBlend = 50.0
    ENDIF
    $APO.CDIS = rBlend
    LIN pTgt C_DIS
  ELSE
    $APO.CDIS = 0.0
    LIN pTgt
  ENDIF
  NoteStream()
END

DEF NoteStream()
  TC_ERR_CODE = 0
  WT_ERR = 0
  IF TC_TASK_STATE == 5 THEN
    TC_TASK_STATE = 0
  ENDIF
END

DEF GoHome()
  DECL INT nV
  DECL INT nA

  IF TC_TASK_BUSY THEN
    RETURN
  ENDIF
  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  $APO.CPTP = 0
  PTP XHOME
  NoteStream()
END

;==================================
; Weld execution
;==================================

DEF TaskExec()
  DECL INT i
  DECL INT nMask
  DECL E6POS pTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF (WT_NPT < 1) OR (WT_NPT > WT_MAXPT) THEN
    WT_ERR = 1
  ENDIF
  IF WT_ERR == 0 THEN
    nMask = 1
    IF WT_NPT >= 3 THEN
      nMask = nMask B_OR 2
    ENDIF
    IF WT_NPT >= 2 THEN
      nMask = nMask B_OR 4
    ENDIF
    IF (TC_PAGE_MASK B_AND nMask) <> nMask THEN
      WT_ERR = 2
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    FOR i = 1 TO WT_NPT
      IF NOT(WT_PT[i].PVALID) THEN
        WT_ERR = 2
      ENDIF
    ENDFOR
    FOR i = 1 TO WT_NSEAM
      IF NOT(WT_SEG[i].SVALID) THEN
        WT_ERR = 2
      ENDIF
      IF (WT_SEG[i].WEAVE < 0) OR (WT_SEG[i].WEAVE > 2) THEN
        WT_ERR = 9
      ENDIF
    ENDFOR
  ENDIF
  IF WT_ERR == 0 THEN
    IF (WT_TOOL < 1) OR (WT_TOOL > 16) OR (WT_BASE < 0) OR (WT_BASE > 32) THEN
      WT_ERR = 3
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF WT_NPT >= 3 THEN
      IF WT_PT[2].CPRE >= PosDist(WT_PT[1].P,WT_PT[2].P) THEN
        WT_ERR = 7
      ENDIF
      IF WT_PT[2].CPOST >= PosDist(WT_PT[2].P,WT_PT[3].P) THEN
        WT_ERR = 7
      ENDIF
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF WT_NPT >= 4 THEN
      IF (WT_PT[2].CPOST + WT_PT[3].CPRE) >= PosDist(WT_PT[2].P,WT_PT[3].P) THEN
        WT_ERR = 7
      ENDIF
      IF WT_PT[3].CPOST >= PosDist(WT_PT[3].P,WT_PT[4].P) THEN
        WT_ERR = 7
      ENDIF
    ENDIF
  ENDIF
  IF WT_ERR <> 0 THEN
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  TC_ERR_CODE = 0
  TC_TASK_STATE = 2
  TC_TASK_BUSY = TRUE
  TC_PROGRESS = 0
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  SetStoredPtp()
  $APO.CDIS = 0.0

  IF WT_APPROACH > 1.0 THEN
    TorchShift(WT_PT[1].P,-WT_APPROACH,1)
  ENDIF
  SetAirSpeed()
  pTgt = WT_PT[1].P
  LIN pTgt

  IF WT_NSEAM < 1 THEN
    IF WT_APPROACH > 1.0 THEN
      TorchShift(WT_PT[1].P,-WT_APPROACH,0)
    ENDIF
    TC_PROGRESS = 10000
    TC_TASK_BUSY = FALSE
    TC_TASK_STATE = 4
    RETURN
  ENDIF

  TC_TASK_STATE = 3
  ArcOn(1)
  IF WT_ERR <> 0 THEN
    ArcOff()
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    TC_TASK_BUSY = FALSE
    TC_SEG_ACTIVE = 0
    RETURN
  ENDIF

  WeldChain()
  ArcOff()
  TC_PROGRESS = 10000
  SetAirSpeed()
  IF WT_APPROACH > 1.0 THEN
    TorchShift(WT_PT[WT_NPT].P,-WT_APPROACH,0)
  ENDIF
  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  TC_TASK_STATE = 4
END

DEF WeldChain()
  DECL INT i
  DECL REAL rLen
  DECL REAL rF
  DECL E6POS pCur
  DECL E6POS pTgt

  pCur = WT_PT[1].P
  FOR i = 1 TO WT_NSEAM
    TC_SEG_ACTIVE = i
    TC_PROGRESS = ((i - 1) * 10000) / WT_NSEAM
    SetSegProc(i)
    pTgt = WT_PT[i + 1].P
    IF i < WT_NSEAM THEN
      rLen = PosDist(WT_PT[i].P,WT_PT[i + 1].P)
      IF (WT_PT[i + 1].CPRE > 0.1) AND (rLen > WT_PT[i + 1].CPRE) THEN
        rF = 1.0 - (WT_PT[i + 1].CPRE / rLen)
        LerpPos(WT_PT[i].P,WT_PT[i + 1].P,rF,pTgt)
      ENDIF
    ENDIF
    WeldLine(i,pCur,pTgt)
    pCur = pTgt
    IF i < WT_NSEAM THEN
      SetCornerProc(i + 1)
      pTgt = WT_PT[i + 1].P
      LIN pTgt
      pCur = pTgt
      IF WT_PT[i + 1].CDWELL > 0.01 THEN
        WAIT SEC WT_PT[i + 1].CDWELL
      ENDIF
      rLen = PosDist(WT_PT[i + 1].P,WT_PT[i + 2].P)
      IF (WT_PT[i + 1].CPOST > 0.1) AND (rLen > WT_PT[i + 1].CPOST) THEN
        rF = WT_PT[i + 1].CPOST / rLen
        LerpPos(WT_PT[i + 1].P,WT_PT[i + 2].P,rF,pTgt)
        LIN pTgt
        pCur = pTgt
      ENDIF
    ENDIF
  ENDFOR

  IF WT_CRATER > 0.1 THEN
    rLen = PosDist(WT_PT[WT_NPT - 1].P,WT_PT[WT_NPT].P)
    IF rLen > WT_CRATER THEN
      rF = 1.0 - (WT_CRATER / rLen)
      LerpPos(WT_PT[WT_NPT - 1].P,WT_PT[WT_NPT].P,rF,pTgt)
      LIN pTgt
    ENDIF
  ENDIF
END

DEF TaskAbort()
  INTERRUPT OFF 25
  BRAKE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  TC_ARC_ON = FALSE
  WT_ABORTED = TRUE
  WT_ERR = 5
  TC_ERR_CODE = 5
  TC_TASK_STATE = 5
  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  RESUME
END

;==================================
; Motion and weave
;==================================

DEF WeldLine(nS:IN,pA:IN,pB:IN)
  ; The weave is a Y offset in the point frame, so the PC sends orientations
  ; whose local X runs along the seam. A triangle uses the peaks and the
  ; zero crossings. A sine uses eight samples per period unless TC_SAMPLES
  ; says otherwise. More than 400 samples on one seam is capped.
  DECL INT nS
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pW
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL INT nPer
  DECL INT nSteps
  DECL INT nIn
  DECL INT i
  DECL REAL rLen
  DECL REAL rPeriod
  DECL REAL rF
  DECL REAL rU
  DECL REAL rAmp
  DECL REAL rStep

  $APO.CDIS = 0.0
  rLen = PosDist(pA,pB)
  rAmp = WT_SEG[nS].AMP
  IF (WT_SEG[nS].WEAVE == 0) OR (rAmp < 0.1) OR (WT_SEG[nS].FREQ < 0.1) OR (rLen < 1.0) THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  nPer = WT_SAMPLES
  IF (nPer < 2) OR (nPer > 32) THEN
    IF WT_SEG[nS].WEAVE == 1 THEN
      nPer = 4
    ELSE
      nPer = 8
    ENDIF
  ENDIF
  rPeriod = WT_SEG[nS].SPEED / WT_SEG[nS].FREQ
  IF rPeriod < 0.5 THEN
    rPeriod = 0.5
  ENDIF
  rStep = nPer
  rStep = rPeriod / rStep
  nSteps = rLen / rStep
  IF nSteps > 400 THEN
    nSteps = 400
  ENDIF
  IF nSteps < 2 THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  rStep = nSteps
  rStep = rLen / rStep
  IF WT_SEG[nS].WEAVE == 2 THEN
    $APO.CDIS = rStep * 0.8
  ELSE
    $APO.CDIS = rStep * 0.25
  ENDIF
  IF $APO.CDIS < 0.2 THEN
    $APO.CDIS = 0.2
  ENDIF

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  FOR i = 1 TO nSteps - 1
    rF = i
    rF = rF / nSteps
    LerpPos(pA,pB,rF,pW)
    nIn = (i - 1) - ((i - 1) / nPer) * nPer
    rU = nIn
    rU = rU / nPer
    fOff.Y = WeaveY(WT_SEG[nS].WEAVE,rAmp,rU)
    pTgt = pW : fOff
    LIN pTgt C_DIS
  ENDFOR
  $APO.CDIS = 0.0
  pTgt = pB
  LIN pTgt
END

DEFFCT REAL WeaveY(nMode:IN,rAmp:IN,rU:IN)
  ; rU is 0..1 inside one weave period. Triangle peaks are at 0.25 and 0.75.
  DECL INT nMode
  DECL REAL rAmp
  DECL REAL rU
  DECL REAL rY

  IF nMode == 2 THEN
    RETURN (rAmp * SIN(rU * 360.0))
  ENDIF
  IF rU < 0.25 THEN
    rY = rU / 0.25
  ELSE
    IF rU < 0.75 THEN
      rY = 1.0 - ((rU - 0.25) / 0.25)
    ELSE
      rY = -1.0 + ((rU - 0.75) / 0.25)
    ENDIF
  ENDIF
  RETURN (rAmp * rY)
ENDFCT

DEF TorchShift(pFrom:IN,rZ:IN,nPtp:IN)
  DECL E6POS pFrom
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL REAL rZ
  DECL INT nPtp

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  fOff.Z = rZ
  pTgt = pFrom : fOff
  IF nPtp == 1 THEN
    PTP pTgt
  ELSE
    LIN pTgt
  ENDIF
END

DEF SetJointDyn()
  DECL REAL rV
  DECL INT nV
  DECL INT nA

  rV = BitsToReal(RJ_AXIS_SPEED)
  nV = rV
  rV = BitsToReal(RJ_AXIS_ACC)
  nA = rV
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  WT_AXSPEED = nV
  WT_AXACC = nA
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  rV = BitsToReal(RJ_EXT_SPEED)
  IF (rV >= 1.0) AND (rV <= 100.0) THEN
    WT_EXSPEED = rV
    RedVelExAx[1] = rV
    RedVelExAx[2] = rV
    RedVelExAx[3] = rV
  ENDIF
  rV = BitsToReal(RJ_EXT_ACC)
  IF (rV >= 1.0) AND (rV <= 100.0) THEN
    WT_EXACC = rV
    RedAccExAx[1] = rV
    RedAccExAx[2] = rV
    RedAccExAx[3] = rV
  ENDIF
END

DEF SetStoredPtp()
  DECL INT nV
  DECL INT nA

  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  IF (WT_EXSPEED >= 1.0) AND (WT_EXSPEED <= 100.0) THEN
    RedVelExAx[1] = WT_EXSPEED
    RedVelExAx[2] = WT_EXSPEED
    RedVelExAx[3] = WT_EXSPEED
  ENDIF
  IF (WT_EXACC >= 1.0) AND (WT_EXACC <= 100.0) THEN
    RedAccExAx[1] = WT_EXACC
    RedAccExAx[2] = WT_EXACC
    RedAccExAx[3] = WT_EXACC
  ENDIF
END

DEF SetCartDyn()
  DECL REAL rV

  rV = BitsToReal(RT_SPEED) / 1000.0
  IF rV < 0.001 THEN
    rV = 0.05
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  rV = BitsToReal(RT_ACC)
  IF (rV < 0.05) OR (rV > 10.0) THEN
    rV = 2.3
  ENDIF
  $ACC.CP = rV
  rV = BitsToReal(RT_ORI)
  IF (rV < 1.0) OR (rV > 400.0) THEN
    rV = 200.0
  ENDIF
  $VEL.ORI1 = rV
  $VEL.ORI2 = rV
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
END

DEF SetAirSpeed()
  DECL REAL rV

  rV = WT_AIRSPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.05
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
END

DEF SetSegProc(nS:IN)
  DECL INT nS
  DECL REAL rV

  rV = WT_SEG[nS].SPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.001
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
END

DEF SetCornerProc(nP:IN)
  DECL INT nP
  DECL REAL rOri

  rOri = WT_PT[nP].CROT * 6.0
  IF rOri < 1.0 THEN
    rOri = 1.0
  ENDIF
  IF rOri > 200.0 THEN
    rOri = 200.0
  ENDIF
  $VEL.ORI1 = rOri
  $VEL.ORI2 = rOri
END

DEF ArcOn(nS:IN)
  DECL INT nS

  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
  WT_GAS_REQ = TRUE
  WAIT SEC 0.3
  WT_ARC_REQ = TRUE
  TC_ARC_ON = TRUE
  $TIMER_STOP[21] = TRUE
  $TIMER[21] = 0
  $TIMER_STOP[21] = FALSE
  WAIT FOR (DI_ArcStability) OR ($TIMER[21] > 3000)
  $TIMER_STOP[21] = TRUE
  IF NOT(DI_ArcStability) THEN
    WT_ERR = 4
  ENDIF
END

DEF ArcOff()
  WT_ARC_REQ = FALSE
  TC_ARC_ON = FALSE
  WAIT SEC 0.3
  WT_GAS_REQ = FALSE
END

DEF LerpPos(pA:IN,pB:IN,rF:IN,pR:OUT)
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pR
  DECL REAL rF

  pR = pA
  pR.X = pA.X + (pB.X - pA.X) * rF
  pR.Y = pA.Y + (pB.Y - pA.Y) * rF
  pR.Z = pA.Z + (pB.Z - pA.Z) * rF
  pR.A = pA.A + (pB.A - pA.A) * rF
  pR.B = pA.B + (pB.B - pA.B) * rF
  pR.C = pA.C + (pB.C - pA.C) * rF
  pR.E1 = pA.E1 + (pB.E1 - pA.E1) * rF
  pR.E2 = pA.E2 + (pB.E2 - pA.E2) * rF
  pR.E3 = pA.E3 + (pB.E3 - pA.E3) * rF
END

DEFFCT REAL PosDist(pA:IN,pB:IN)
  DECL E6POS pA
  DECL E6POS pB
  DECL REAL dx
  DECL REAL dy
  DECL REAL dz

  dx = pB.X - pA.X
  dy = pB.Y - pA.Y
  dz = pB.Z - pA.Z
  RETURN SQRT(dx * dx + dy * dy + dz * dz)
ENDFCT
