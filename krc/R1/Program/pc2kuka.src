&ACCESS RV
&REL 4
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF pc2kuka( )

  ; One Profinet image, $IN[3025]..$IN[4047]. Signals do not overlap.
  ; The robot latches motion on every RS_TOGGLE edge.
  ;
  ;   1 realtime joint target, RJ_A1..A6 RJ_E1..E3, move now
  ;   2 one waypoint of a planned joint trajectory, same RJ_* bits
  ;   3 one weld seam: start, end, two tool-Y deflection angles, weave
  ;   4 weld the latched seam
  ;   5 clear the buffer
  ;
  ; There is no Cartesian stream. Command 2 runs the host's joint plan.
  ; RS_POINT_INDEX is 1..RS_POINT_TOTAL. RS_CONT blends every waypoint
  ; except the last one, so the arm stops at the end of the plan.
  ; A total of 0 leaves the stream open and every CONT point blends.
  ; WS_* is not a command. sps.sub applies it while no seam is busy.
  ; Command 3 copies job, wire, voltage, dynamics and program from WS_*.
  ;
  ; RS_RESET and RS_GOTO_HOME are pulses and are handled before RS_CMD.
  ; RS_ABORT brakes the motion from any line. This program never writes
  ; EWM_*. It uses $TIMER[21]. sps.sub uses $TIMER[20] and $TIMER[22].

  DECL INT nCmd

  BAS(#INITMOV,0)
  $APO.CDIS = 0.0
  $APO.CPTP = 0
  $ADVANCE = 3

  WT_TASK_ID = 0
  WT_NSEAM = 0
  WT_NPT = 0
  WT_TOOL = 1
  WT_BASE = 0
  WT_ERR = 0
  WT_SAMPLES = 0
  WT_ACT_PROG = 0
  WT_TILT_S = 0.0
  WT_TILT_E = 0.0
  WT_ABORTED = FALSE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  ClearTask()

  TC_ACK_CMD = 0
  TC_ACK_TASK_ID = 0
  TC_ACK_POINT_COUNT = 0
  TC_ACK_FRAME_NO = 0
  TC_TASK_STATE = 0
  TC_ERR_CODE = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
  TC_TASK_BUSY = FALSE
  TC_ARC_ON = FALSE
  TC_ACK_TOGGLE = RS_TOGGLE

  INTERRUPT DECL 25 WHEN RS_ABORT==TRUE DO TaskAbort()
  INTERRUPT ON 25

  LOOP
    IF WT_ABORTED THEN
      WAIT FOR NOT(RS_ABORT)
      WT_ABORTED = FALSE
      INTERRUPT ON 25
    ENDIF

    WAIT FOR (RS_TOGGLE <> TC_ACK_TOGGLE) OR RS_RESET OR RS_GOTO_HOME
    IF WT_ABORTED THEN
      CONTINUE
    ENDIF

    IF RS_RESET THEN
      WT_ERR = 0
      TC_ERR_CODE = 0
      IF TC_TASK_STATE == 5 THEN
        TC_TASK_STATE = 0
      ENDIF
      WAIT FOR NOT(RS_RESET)
      CONTINUE
    ENDIF

    IF RS_GOTO_HOME THEN
      GoHome()
      WAIT FOR NOT(RS_GOTO_HOME)
      CONTINUE
    ENDIF

    nCmd = RS_CMD
    SWITCH nCmd
    CASE 1
      JointMove()
    CASE 2
      JointTrajMove()
    CASE 3
      ReadSeam()
    CASE 4
      TaskExec()
    CASE 5
      ClearTask()
      WT_TASK_ID = 0
      WT_NPT = 0
      WT_NSEAM = 0
      WT_TILT_S = 0.0
      WT_TILT_E = 0.0
      WT_ACT_PROG = 0
      WT_ERR = 0
      TC_ERR_CODE = 0
      TC_TASK_STATE = 0
    DEFAULT
      WT_ERR = 6
      TC_ERR_CODE = 6
      TC_TASK_STATE = 5
    ENDSWITCH

    TC_ACK_CMD = nCmd
    TC_ACK_TASK_ID = WT_TASK_ID
    TC_ACK_FRAME_NO = RS_POINT_INDEX
    IF nCmd == 2 THEN
      TC_ACK_POINT_COUNT = RS_POINT_TOTAL
    ELSE
      TC_ACK_POINT_COUNT = WT_NPT
    ENDIF
    TC_ACK_TOGGLE = RS_TOGGLE
  ENDLOOP

END

;==================================
; Buffer
;==================================

DEF ClearTask()
  DECL INT i

  FOR i = 1 TO WT_MAXPT
    WT_PT[i].PVALID = FALSE
    WT_PT[i].CPRE = 0.0
    WT_PT[i].CPOST = 0.0
    WT_PT[i].CROT = 0.0
    WT_PT[i].CDWELL = 0.0
  ENDFOR
  FOR i = 1 TO WT_MAXSEAM
    WT_SEG[i].SVALID = FALSE
    WT_SEG[i].SPEED = 0.0
    WT_SEG[i].AMP = 0.0
    WT_SEG[i].FREQ = 0.0
    WT_SEG[i].WEAVE = 0
    WT_SEG[i].JOB = 0
    WT_SEG[i].WIRE = 0
    WT_SEG[i].VOLT = 0
    WT_SEG[i].DYN = 0
  ENDFOR
  WT_SAMPLES = 0
  WT_TILT_S = 0.0
  WT_TILT_E = 0.0
  WT_ACT_PROG = 0
  TC_PAGE_MASK = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
END

DEF ReadSeam()
  ; Command 3. One start, one end, two deflection angles and the weave.
  ; Job, wire, voltage, dynamics and program are taken from the live WS_*
  ; image in the same transfer.

  WT_TASK_ID = RS_TASK_ID
  WT_ERR = 0
  ClearTask()
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF (RS_WEAVE < 0) OR (RS_WEAVE > 2) THEN
    WT_ERR = 9
    TC_ERR_CODE = 9
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  WT_PT[1].P = $POS_ACT
  WT_PT[1].P.X = BitsToReal(WN_SX)
  WT_PT[1].P.Y = BitsToReal(WN_SY)
  WT_PT[1].P.Z = BitsToReal(WN_SZ)
  WT_PT[1].P.A = BitsToReal(WN_SA)
  WT_PT[1].P.B = BitsToReal(WN_SB)
  WT_PT[1].P.C = BitsToReal(WN_SC)
  WT_PT[1].PVALID = TRUE

  WT_PT[2].P = $POS_ACT
  WT_PT[2].P.X = BitsToReal(WN_EX)
  WT_PT[2].P.Y = BitsToReal(WN_EY)
  WT_PT[2].P.Z = BitsToReal(WN_EZ)
  WT_PT[2].P.A = BitsToReal(WN_EA)
  WT_PT[2].P.B = BitsToReal(WN_EB)
  WT_PT[2].P.C = BitsToReal(WN_EC)
  WT_PT[2].PVALID = TRUE

  WT_TILT_S = BitsToReal(WN_START_TILT)
  WT_TILT_E = BitsToReal(WN_END_TILT)
  WT_SEG[1].SPEED = BitsToReal(WN_SPEED)
  WT_SEG[1].AMP = BitsToReal(WN_AMP)
  WT_SEG[1].FREQ = BitsToReal(WN_FREQ)
  WT_SEG[1].WEAVE = RS_WEAVE
  WT_SEG[1].JOB = WS_JOB_NUMBER
  WT_SEG[1].WIRE = WS_WIRE_SPEED_CORR
  WT_SEG[1].VOLT = WS_ARC_VOLT_CORR
  WT_SEG[1].DYN = WS_DYNAMIN_CORR
  WT_SEG[1].SVALID = TRUE
  WT_ACT_PROG = WS_PRO_NUMBER
  WT_NPT = 2
  WT_NSEAM = 1
  TC_PAGE_MASK = 1
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

;==================================
; Stream and home
;==================================

DEF ApplyFrame()
  IF (RS_TOOL_ID < 1) OR (RS_TOOL_ID > 16) OR (RS_BASE_ID < 0) OR (RS_BASE_ID > 32) THEN
    WT_ERR = 3
    TC_ERR_CODE = 3
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  WT_ERR = 0
END

DEF RequireEnable()
  IF NOT(RS_ENABLE) THEN
    WT_ERR = 8
    TC_ERR_CODE = 8
    TC_TASK_STATE = 5
    RETURN
  ENDIF
  WT_ERR = 0
END

DEF JointMove()
  ; Command 1. One live joint target. CONT uses a short blend.
  JointTarget(30)
END

DEF JointTrajMove()
  ; Command 2. One waypoint of the host plan. The last point is exact.
  DECL INT nBlend

  nBlend = 80
  IF RS_POINT_TOTAL > 0 THEN
    IF RS_POINT_INDEX >= RS_POINT_TOTAL THEN
      nBlend = 0
    ENDIF
  ENDIF
  JointTarget(nBlend)
END

DEF JointTarget(nBlend:IN)
  DECL INT nBlend
  DECL E6AXIS aTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  SetJointDyn()
  aTgt.A1 = BitsToReal(RJ_A1)
  aTgt.A2 = BitsToReal(RJ_A2)
  aTgt.A3 = BitsToReal(RJ_A3)
  aTgt.A4 = BitsToReal(RJ_A4)
  aTgt.A5 = BitsToReal(RJ_A5)
  aTgt.A6 = BitsToReal(RJ_A6)
  aTgt.E1 = BitsToReal(RJ_E1)
  aTgt.E2 = BitsToReal(RJ_E2)
  aTgt.E3 = BitsToReal(RJ_E3)
  aTgt.E4 = $AXIS_ACT.E4
  aTgt.E5 = $AXIS_ACT.E5
  aTgt.E6 = $AXIS_ACT.E6
  IF (nBlend > 0) AND RS_CONT THEN
    $APO.CPTP = nBlend
    PTP aTgt C_PTP
  ELSE
    $APO.CPTP = 0
    PTP aTgt
  ENDIF
  NoteStream()
END

DEF NoteStream()
  TC_ERR_CODE = 0
  WT_ERR = 0
  IF TC_TASK_STATE == 5 THEN
    TC_TASK_STATE = 0
  ENDIF
END

DEF GoHome()
  DECL INT nV
  DECL INT nA

  IF TC_TASK_BUSY THEN
    RETURN
  ENDIF
  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  $APO.CPTP = 0
  PTP XHOME
  NoteStream()
END

;==================================
; Weld execution
;==================================

DEF TaskExec()
  DECL E6POS pTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF (TC_PAGE_MASK B_AND 1) <> 1 THEN
    WT_ERR = 2
  ENDIF
  IF WT_ERR == 0 THEN
    IF RS_TASK_ID <> WT_TASK_ID THEN
      WT_ERR = 2
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF (WT_NPT <> 2) OR (WT_NSEAM <> 1) THEN
      WT_ERR = 1
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF NOT(WT_PT[1].PVALID) OR NOT(WT_PT[2].PVALID) OR NOT(WT_SEG[1].SVALID) THEN
      WT_ERR = 2
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF (WT_SEG[1].WEAVE < 0) OR (WT_SEG[1].WEAVE > 2) THEN
      WT_ERR = 9
    ENDIF
  ENDIF
  IF WT_ERR == 0 THEN
    IF (WT_TOOL < 1) OR (WT_TOOL > 16) OR (WT_BASE < 0) OR (WT_BASE > 32) THEN
      WT_ERR = 3
    ENDIF
  ENDIF
  IF WT_ERR <> 0 THEN
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  TC_ERR_CODE = 0
  TC_TASK_STATE = 2
  TC_TASK_BUSY = TRUE
  TC_PROGRESS = 0
  TC_SEG_ACTIVE = 1
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  SetStoredPtp()
  $APO.CDIS = 0.0

  IF ABS(WT_TILT_S) > 0.05 THEN
    TorchTilt(WT_PT[1].P,WT_TILT_S,1)
  ENDIF
  SetAirSpeed()
  pTgt = WT_PT[1].P
  LIN pTgt

  TC_TASK_STATE = 3
  TC_PROGRESS = 1000
  ArcOn(1)
  IF WT_ERR <> 0 THEN
    ArcOff()
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    TC_TASK_BUSY = FALSE
    TC_SEG_ACTIVE = 0
    RETURN
  ENDIF

  SetSegProc(1)
  WeldLine(1,WT_PT[1].P,WT_PT[2].P)
  ArcOff()
  TC_PROGRESS = 9000
  SetAirSpeed()
  IF ABS(WT_TILT_E) > 0.05 THEN
    TorchTilt(WT_PT[2].P,WT_TILT_E,0)
  ENDIF
  TC_PROGRESS = 10000
  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  TC_TASK_STATE = 4
END

DEF TaskAbort()
  INTERRUPT OFF 25
  BRAKE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  TC_ARC_ON = FALSE
  WT_ABORTED = TRUE
  WT_ERR = 5
  TC_ERR_CODE = 5
  TC_TASK_STATE = 5
  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  RESUME
END

;==================================
; Motion and weave
;==================================

DEF WeldLine(nS:IN,pA:IN,pB:IN)
  ; The weave is a Y offset in the point frame, so the host sends
  ; orientations whose local X runs along the seam. A triangle uses the
  ; peaks and the zero crossings. A sine uses eight samples per period.
  ; More than 400 samples on one seam is capped.
  DECL INT nS
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pW
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL INT nPer
  DECL INT nSteps
  DECL INT nIn
  DECL INT i
  DECL REAL rLen
  DECL REAL rPeriod
  DECL REAL rF
  DECL REAL rU
  DECL REAL rAmp
  DECL REAL rStep

  $APO.CDIS = 0.0
  rLen = PosDist(pA,pB)
  rAmp = WT_SEG[nS].AMP
  IF (WT_SEG[nS].WEAVE == 0) OR (rAmp < 0.1) OR (WT_SEG[nS].FREQ < 0.1) OR (rLen < 1.0) THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  nPer = WT_SAMPLES
  IF (nPer < 2) OR (nPer > 32) THEN
    IF WT_SEG[nS].WEAVE == 1 THEN
      nPer = 4
    ELSE
      nPer = 8
    ENDIF
  ENDIF
  rPeriod = WT_SEG[nS].SPEED / WT_SEG[nS].FREQ
  IF rPeriod < 0.5 THEN
    rPeriod = 0.5
  ENDIF
  rStep = nPer
  rStep = rPeriod / rStep
  nSteps = rLen / rStep
  IF nSteps > 400 THEN
    nSteps = 400
  ENDIF
  IF nSteps < 2 THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  rStep = nSteps
  rStep = rLen / rStep
  IF WT_SEG[nS].WEAVE == 2 THEN
    $APO.CDIS = rStep * 0.8
  ELSE
    $APO.CDIS = rStep * 0.25
  ENDIF
  IF $APO.CDIS < 0.2 THEN
    $APO.CDIS = 0.2
  ENDIF

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  FOR i = 1 TO nSteps - 1
    rF = i
    rF = rF / nSteps
    LerpPos(pA,pB,rF,pW)
    nIn = (i - 1) - ((i - 1) / nPer) * nPer
    rU = nIn
    rU = rU / nPer
    fOff.Y = WeaveY(WT_SEG[nS].WEAVE,rAmp,rU)
    pTgt = pW : fOff
    LIN pTgt C_DIS
  ENDFOR
  $APO.CDIS = 0.0
  pTgt = pB
  LIN pTgt
END

DEFFCT REAL WeaveY(nMode:IN,rAmp:IN,rU:IN)
  ; rU is 0..1 inside one weave period. Triangle peaks are at 0.25 and 0.75.
  DECL INT nMode
  DECL REAL rAmp
  DECL REAL rU
  DECL REAL rY

  IF nMode == 2 THEN
    RETURN (rAmp * SIN(rU * 360.0))
  ENDIF
  IF rU < 0.25 THEN
    rY = rU / 0.25
  ELSE
    IF rU < 0.75 THEN
      rY = 1.0 - ((rU - 0.25) / 0.25)
    ELSE
      rY = -1.0 + ((rU - 0.75) / 0.25)
    ENDIF
  ENDIF
  RETURN (rAmp * rY)
ENDFCT

DEF TorchTilt(pFrom:IN,rTilt:IN,nPtp:IN)
  ; Positive tilt is a rotation about tool Y. The TCP stays on the seam
  ; point, so the torch body swings clear of the part.
  DECL E6POS pFrom
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL REAL rTilt
  DECL INT nPtp

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  fOff.B = rTilt
  pTgt = pFrom : fOff
  IF nPtp == 1 THEN
    PTP pTgt
  ELSE
    LIN pTgt
  ENDIF
END

DEF SetJointDyn()
  DECL INT nV
  DECL INT nA

  nV = RS_AXIS_SPEED
  nA = RS_AXIS_ACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  WT_AXSPEED = nV
  WT_AXACC = nA
  WT_EXSPEED = nV
  WT_EXACC = nA
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  RedVelExAx[1] = nV
  RedVelExAx[2] = nV
  RedVelExAx[3] = nV
  RedAccExAx[1] = nA
  RedAccExAx[2] = nA
  RedAccExAx[3] = nA
END

DEF SetStoredPtp()
  DECL INT nV
  DECL INT nA

  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  RedVelExAx[1] = WT_EXSPEED
  RedVelExAx[2] = WT_EXSPEED
  RedVelExAx[3] = WT_EXSPEED
  RedAccExAx[1] = WT_EXACC
  RedAccExAx[2] = WT_EXACC
  RedAccExAx[3] = WT_EXACC
END

DEF SetAirSpeed()
  DECL REAL rV

  rV = WT_AIRSPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.05
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
END

DEF SetSegProc(nS:IN)
  DECL INT nS
  DECL REAL rV

  rV = WT_SEG[nS].SPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.001
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
END

DEF ArcOn(nS:IN)
  DECL INT nS

  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
  WT_GAS_REQ = TRUE
  WAIT SEC 0.3
  WT_ARC_REQ = TRUE
  TC_ARC_ON = TRUE
  $TIMER_STOP[21] = TRUE
  $TIMER[21] = 0
  $TIMER_STOP[21] = FALSE
  WAIT FOR (DI_ArcStability) OR ($TIMER[21] > 3000)
  $TIMER_STOP[21] = TRUE
  IF NOT(DI_ArcStability) THEN
    WT_ERR = 4
  ENDIF
END

DEF ArcOff()
  WT_ARC_REQ = FALSE
  TC_ARC_ON = FALSE
  WAIT SEC 0.3
  WT_GAS_REQ = FALSE
END

DEF LerpPos(pA:IN,pB:IN,rF:IN,pR:OUT)
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pR
  DECL REAL rF

  pR = pA
  pR.X = pA.X + (pB.X - pA.X) * rF
  pR.Y = pA.Y + (pB.Y - pA.Y) * rF
  pR.Z = pA.Z + (pB.Z - pA.Z) * rF
  pR.A = pA.A + (pB.A - pA.A) * rF
  pR.B = pA.B + (pB.B - pA.B) * rF
  pR.C = pA.C + (pB.C - pA.C) * rF
  pR.E1 = pA.E1 + (pB.E1 - pA.E1) * rF
  pR.E2 = pA.E2 + (pB.E2 - pA.E2) * rF
  pR.E3 = pA.E3 + (pB.E3 - pA.E3) * rF
END

DEFFCT REAL PosDist(pA:IN,pB:IN)
  DECL E6POS pA
  DECL E6POS pB
  DECL REAL dx
  DECL REAL dy
  DECL REAL dz

  dx = pB.X - pA.X
  dy = pB.Y - pA.Y
  dz = pB.Z - pA.Z
  RETURN SQRT(dx * dx + dy * dy + dz * dz)
ENDFCT
