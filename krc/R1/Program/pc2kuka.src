&ACCESS RV
&REL 4
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF pc2kuka( )

  ; Continuous weld task channel over Profinet, $IN[3057]..$IN[4048].
  ;
  ; A task is a chain of up to 4 seams, so up to 5 points, and needs 333
  ; bytes of data. The image holds 124, so the telegram is paged into three
  ; fixed pages. TC_CMD says which page the payload holds, and every field
  ; has a fixed place inside its page, so there is no per item index.
  ;
  ;   TC_CMD 1  points 1, 2, 3
  ;   TC_CMD 2  points 4, 5 and the corners at points 2, 3, 4
  ;   TC_CMD 3  the four seam processes and the task parameters
  ;   TC_CMD 4  execute
  ;   TC_CMD 5  clear
  ;
  ; The PC writes the payload first and flips TC_TOGGLE in a later frame,
  ; because the output image is written with several calls and is not updated
  ; atomically. The robot latches on every toggle edge and echoes the toggle,
  ; the command and the frame number, so the PC knows the page landed before
  ; it sends the next one. A whole task is four frames, 0.2 s at a 50 ms
  ; cycle.
  ;
  ; Page 1 and page 3 are always required. Page 2 is required from 2 seams up,
  ; because that is where the corner parameters live. TC_SEAM_COUNT 0 means
  ; move to point 1 and do not strike an arc.
  ;
  ; This program never writes EWM_*. It requests the arc through WT_ARC_REQ
  ; and WT_ACT_*, and sps.sub is the only writer of the welder outputs.
  ; This program uses $TIMER[21]. The status SPS uses $TIMER[20].

  DECL INT nCmd

  BAS(#INITMOV,0)
  $APO.CDIS = 0.0
  $ADVANCE = 3

  WT_TASK_ID = 0
  WT_NSEAM = 0
  WT_NPT = 0
  WT_TOOL = 1
  WT_BASE = 0
  WT_STEP = 2
  WT_ERR = 0
  WT_ABORTED = FALSE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  ClearTask()

  TC_ACK_CMD = 0
  TC_ACK_TASK_ID = 0
  TC_ACK_SEAM_COUNT = 0
  TC_ACK_FRAME_NO = 0
  TC_TASK_STATE = 0
  TC_ERR_CODE = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
  TC_TASK_BUSY = FALSE
  TC_ARC_ON = FALSE
  TC_ACK_TOGGLE = TC_TOGGLE

  INTERRUPT DECL 25 WHEN TC_ABORT==TRUE DO TaskAbort()
  INTERRUPT ON 25

  LOOP
    IF WT_ABORTED THEN
      WAIT FOR NOT(TC_ABORT)
      WT_ABORTED = FALSE
      TC_TASK_STATE = 0
      INTERRUPT ON 25
    ENDIF

    ; the control header works outside the page handshake, so a reset or a
    ; move home does not need a task
    WAIT FOR (TC_TOGGLE <> TC_ACK_TOGGLE) OR RS_RESET OR RS_GOTO_HOME

    IF RS_RESET THEN
      WT_ERR = 0
      TC_ERR_CODE = 0
      TC_TASK_STATE = 0
      WAIT FOR NOT(RS_RESET)
      CONTINUE
    ENDIF

    IF RS_GOTO_HOME THEN
      GoHome()
      WAIT FOR NOT(RS_GOTO_HOME)
      CONTINUE
    ENDIF

    nCmd = TC_CMD

    SWITCH nCmd
    CASE 1
      ReadPage1()
    CASE 2
      ReadPage2()
    CASE 3
      ReadPage3()
    CASE 4
      TaskExec()
    CASE 5
      ClearTask()
      WT_ERR = 0
      TC_ERR_CODE = 0
      TC_TASK_STATE = 0
    DEFAULT
      WT_ERR = 6
      TC_ERR_CODE = 6
      TC_TASK_STATE = 5
    ENDSWITCH

    TC_ACK_CMD = nCmd
    TC_ACK_TASK_ID = WT_TASK_ID
    TC_ACK_SEAM_COUNT = WT_NSEAM
    TC_ACK_FRAME_NO = TC_FRAME_NO
    TC_ACK_TOGGLE = TC_TOGGLE
  ENDLOOP

END

;==================================
; Buffer handling
;==================================

DEF ClearTask()
  DECL INT i

  FOR i = 1 TO WT_MAXPT
    WT_PT[i].PVALID = FALSE
    WT_PT[i].CPRE = 0.0
    WT_PT[i].CPOST = 0.0
    WT_PT[i].CROT = 0.0
    WT_PT[i].CDWELL = 0.0
  ENDFOR
  FOR i = 1 TO WT_MAXPT - 1
    WT_SEG[i].SVALID = FALSE
    WT_SEG[i].SPEED = 0.0
    WT_SEG[i].AMP = 0.0
    WT_SEG[i].FREQ = 0.0
    WT_SEG[i].JOB = 0
    WT_SEG[i].WIRE = 0
    WT_SEG[i].VOLT = 0
    WT_SEG[i].DYN = 0
    WT_SEG[i].WEAVE = FALSE
  ENDFOR
  TC_PAGE_MASK = 0
  TC_SEG_ACTIVE = 0
  TC_PROGRESS = 0
END

DEF NewTask()
  ; a page 1 frame starts a new task, so the header is taken from it and the
  ; buffer is cleared before the points are stored
  WT_TASK_ID = TC_TASK_ID
  WT_NSEAM = TC_SEAM_COUNT
  WT_NPT = TC_SEAM_COUNT + 1
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  WT_STEP = RS_STEP_MODE
  WT_ERR = 0
  ClearTask()
END

DEF ReadPage1()
  NewTask()

  IF (WT_NSEAM < 0) OR (WT_NSEAM > WT_MAXPT - 1) THEN
    WT_ERR = 1
    TC_ERR_CODE = 1
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  ; point 1 is always present, points 2 and 3 only if the chain is long enough
  WT_PT[1].P.X = BitsToReal(TC_P1_X)
  WT_PT[1].P.Y = BitsToReal(TC_P1_Y)
  WT_PT[1].P.Z = BitsToReal(TC_P1_Z)
  WT_PT[1].P.A = BitsToReal(TC_P1_A)
  WT_PT[1].P.B = BitsToReal(TC_P1_B)
  WT_PT[1].P.C = BitsToReal(TC_P1_C)
  WT_PT[1].P.E1 = BitsToReal(TC_P1_E1)
  WT_PT[1].P.E2 = BitsToReal(TC_P1_E2)
  WT_PT[1].P.E3 = BitsToReal(TC_P1_E3)
  WT_PT[1].P.E4 = $AXIS_ACT.E4
  WT_PT[1].P.E5 = $AXIS_ACT.E5
  WT_PT[1].P.E6 = $AXIS_ACT.E6
  WT_PT[1].P.S = TC_P1_S
  WT_PT[1].P.T = TC_P1_T
  WT_PT[1].PVALID = TRUE

  IF WT_NPT >= 2 THEN
    WT_PT[2].P.X = BitsToReal(TC_P2_X)
    WT_PT[2].P.Y = BitsToReal(TC_P2_Y)
    WT_PT[2].P.Z = BitsToReal(TC_P2_Z)
    WT_PT[2].P.A = BitsToReal(TC_P2_A)
    WT_PT[2].P.B = BitsToReal(TC_P2_B)
    WT_PT[2].P.C = BitsToReal(TC_P2_C)
    WT_PT[2].P.E1 = BitsToReal(TC_P2_E1)
    WT_PT[2].P.E2 = BitsToReal(TC_P2_E2)
    WT_PT[2].P.E3 = BitsToReal(TC_P2_E3)
    WT_PT[2].P.E4 = $AXIS_ACT.E4
    WT_PT[2].P.E5 = $AXIS_ACT.E5
    WT_PT[2].P.E6 = $AXIS_ACT.E6
    WT_PT[2].P.S = TC_P2_S
    WT_PT[2].P.T = TC_P2_T
    WT_PT[2].PVALID = TRUE
  ENDIF

  IF WT_NPT >= 3 THEN
    WT_PT[3].P.X = BitsToReal(TC_P3_X)
    WT_PT[3].P.Y = BitsToReal(TC_P3_Y)
    WT_PT[3].P.Z = BitsToReal(TC_P3_Z)
    WT_PT[3].P.A = BitsToReal(TC_P3_A)
    WT_PT[3].P.B = BitsToReal(TC_P3_B)
    WT_PT[3].P.C = BitsToReal(TC_P3_C)
    WT_PT[3].P.E1 = BitsToReal(TC_P3_E1)
    WT_PT[3].P.E2 = BitsToReal(TC_P3_E2)
    WT_PT[3].P.E3 = BitsToReal(TC_P3_E3)
    WT_PT[3].P.E4 = $AXIS_ACT.E4
    WT_PT[3].P.E5 = $AXIS_ACT.E5
    WT_PT[3].P.E6 = $AXIS_ACT.E6
    WT_PT[3].P.S = TC_P3_S
    WT_PT[3].P.T = TC_P3_T
    WT_PT[3].PVALID = TRUE
  ENDIF

  TC_PAGE_MASK = TC_PAGE_MASK B_OR 1
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

DEF ReadPage2()
  IF TC_TASK_ID <> WT_TASK_ID THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  IF WT_NPT >= 4 THEN
    WT_PT[4].P.X = BitsToReal(TC_P4_X)
    WT_PT[4].P.Y = BitsToReal(TC_P4_Y)
    WT_PT[4].P.Z = BitsToReal(TC_P4_Z)
    WT_PT[4].P.A = BitsToReal(TC_P4_A)
    WT_PT[4].P.B = BitsToReal(TC_P4_B)
    WT_PT[4].P.C = BitsToReal(TC_P4_C)
    WT_PT[4].P.E1 = BitsToReal(TC_P4_E1)
    WT_PT[4].P.E2 = BitsToReal(TC_P4_E2)
    WT_PT[4].P.E3 = BitsToReal(TC_P4_E3)
    WT_PT[4].P.E4 = $AXIS_ACT.E4
    WT_PT[4].P.E5 = $AXIS_ACT.E5
    WT_PT[4].P.E6 = $AXIS_ACT.E6
    WT_PT[4].P.S = TC_P4_S
    WT_PT[4].P.T = TC_P4_T
    WT_PT[4].PVALID = TRUE
  ENDIF

  IF WT_NPT >= 5 THEN
    WT_PT[5].P.X = BitsToReal(TC_P5_X)
    WT_PT[5].P.Y = BitsToReal(TC_P5_Y)
    WT_PT[5].P.Z = BitsToReal(TC_P5_Z)
    WT_PT[5].P.A = BitsToReal(TC_P5_A)
    WT_PT[5].P.B = BitsToReal(TC_P5_B)
    WT_PT[5].P.C = BitsToReal(TC_P5_C)
    WT_PT[5].P.E1 = BitsToReal(TC_P5_E1)
    WT_PT[5].P.E2 = BitsToReal(TC_P5_E2)
    WT_PT[5].P.E3 = BitsToReal(TC_P5_E3)
    WT_PT[5].P.E4 = $AXIS_ACT.E4
    WT_PT[5].P.E5 = $AXIS_ACT.E5
    WT_PT[5].P.E6 = $AXIS_ACT.E6
    WT_PT[5].P.S = TC_P5_S
    WT_PT[5].P.T = TC_P5_T
    WT_PT[5].PVALID = TRUE
  ENDIF

  ; corners sit at the inner points, so at point 2 up to point WT_NPT-1
  IF WT_NPT >= 3 THEN
    WT_PT[2].CPRE = BitsToReal(TC_C2_PRE)
    WT_PT[2].CPOST = BitsToReal(TC_C2_POST)
    WT_PT[2].CROT = BitsToReal(TC_C2_ROT)
    WT_PT[2].CDWELL = TC_C2_DWELL / 100.0
  ENDIF
  IF WT_NPT >= 4 THEN
    WT_PT[3].CPRE = BitsToReal(TC_C3_PRE)
    WT_PT[3].CPOST = BitsToReal(TC_C3_POST)
    WT_PT[3].CROT = BitsToReal(TC_C3_ROT)
    WT_PT[3].CDWELL = TC_C3_DWELL / 100.0
  ENDIF
  IF WT_NPT >= 5 THEN
    WT_PT[4].CPRE = BitsToReal(TC_C4_PRE)
    WT_PT[4].CPOST = BitsToReal(TC_C4_POST)
    WT_PT[4].CROT = BitsToReal(TC_C4_ROT)
    WT_PT[4].CDWELL = TC_C4_DWELL / 100.0
  ENDIF

  TC_PAGE_MASK = TC_PAGE_MASK B_OR 2
  TC_TASK_STATE = 1
END

DEF ReadPage3()
  IF TC_TASK_ID <> WT_TASK_ID THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  IF WT_NSEAM >= 1 THEN
    WT_SEG[1].SPEED = BitsToReal(TC_SG1_SPEED)
    WT_SEG[1].AMP = BitsToReal(TC_SG1_AMP)
    WT_SEG[1].FREQ = BitsToReal(TC_SG1_FREQ)
    WT_SEG[1].JOB = TC_SG1_JOB
    WT_SEG[1].WIRE = TC_SG1_WIRE
    WT_SEG[1].VOLT = TC_SG1_VOLT
    WT_SEG[1].DYN = TC_SG1_DYN
    WT_SEG[1].WEAVE = TC_WEAVE_ON
    WT_SEG[1].SVALID = TRUE
  ENDIF
  IF WT_NSEAM >= 2 THEN
    WT_SEG[2].SPEED = BitsToReal(TC_SG2_SPEED)
    WT_SEG[2].AMP = BitsToReal(TC_SG2_AMP)
    WT_SEG[2].FREQ = BitsToReal(TC_SG2_FREQ)
    WT_SEG[2].JOB = TC_SG2_JOB
    WT_SEG[2].WIRE = TC_SG2_WIRE
    WT_SEG[2].VOLT = TC_SG2_VOLT
    WT_SEG[2].DYN = TC_SG2_DYN
    WT_SEG[2].WEAVE = TC_WEAVE_ON
    WT_SEG[2].SVALID = TRUE
  ENDIF
  IF WT_NSEAM >= 3 THEN
    WT_SEG[3].SPEED = BitsToReal(TC_SG3_SPEED)
    WT_SEG[3].AMP = BitsToReal(TC_SG3_AMP)
    WT_SEG[3].FREQ = BitsToReal(TC_SG3_FREQ)
    WT_SEG[3].JOB = TC_SG3_JOB
    WT_SEG[3].WIRE = TC_SG3_WIRE
    WT_SEG[3].VOLT = TC_SG3_VOLT
    WT_SEG[3].DYN = TC_SG3_DYN
    WT_SEG[3].WEAVE = TC_WEAVE_ON
    WT_SEG[3].SVALID = TRUE
  ENDIF
  IF WT_NSEAM >= 4 THEN
    WT_SEG[4].SPEED = BitsToReal(TC_SG4_SPEED)
    WT_SEG[4].AMP = BitsToReal(TC_SG4_AMP)
    WT_SEG[4].FREQ = BitsToReal(TC_SG4_FREQ)
    WT_SEG[4].JOB = TC_SG4_JOB
    WT_SEG[4].WIRE = TC_SG4_WIRE
    WT_SEG[4].VOLT = TC_SG4_VOLT
    WT_SEG[4].DYN = TC_SG4_DYN
    WT_SEG[4].WEAVE = TC_WEAVE_ON
    WT_SEG[4].SVALID = TRUE
  ENDIF

  WT_CRATER = BitsToReal(TC_CRATER)
  WT_APPROACH = BitsToReal(TC_APPROACH)
  WT_AIRSPEED = BitsToReal(TC_AIRSPEED)
  WT_AXSPEED = BitsToReal(TC_AXSPEED)
  WT_AXACC = BitsToReal(TC_AXACC)
  WT_EXSPEED = BitsToReal(TC_EXSPEED)
  WT_EXACC = BitsToReal(TC_EXACC)

  TC_PAGE_MASK = TC_PAGE_MASK B_OR 4
  TC_TASK_STATE = 1
END

;==================================
; Execution
;==================================

DEF TaskExec()
  DECL INT i
  DECL INT nMask
  DECL E6POS pTgt
  DECL FRAME fOff

  WT_ERR = 0
  IF NOT(RS_ENABLE) THEN
    WT_ERR = 8
  ENDIF
  IF (WT_ERR == 0) AND ((WT_NSEAM < 0) OR (WT_NSEAM > WT_MAXPT - 1)) THEN
    WT_ERR = 1
  ENDIF

  ; page 1 and page 3 are always needed, page 2 only once there is a corner
  IF WT_ERR == 0 THEN
    nMask = 5
    IF WT_NSEAM >= 2 THEN
      nMask = 7
    ENDIF
    IF WT_NSEAM == 0 THEN
      nMask = 1
    ENDIF
    IF (TC_PAGE_MASK B_AND nMask) <> nMask THEN
      WT_ERR = 2
    ENDIF
  ENDIF

  IF WT_ERR == 0 THEN
    FOR i = 1 TO WT_NPT
      IF NOT(WT_PT[i].PVALID) THEN
        WT_ERR = 2
      ENDIF
    ENDFOR
    FOR i = 1 TO WT_NSEAM
      IF NOT(WT_SEG[i].SVALID) THEN
        WT_ERR = 2
      ENDIF
    ENDFOR
  ENDIF

  IF WT_ERR == 0 THEN
    IF (WT_TOOL < 1) OR (WT_TOOL > 16) OR (WT_BASE < 0) OR (WT_BASE > 32) THEN
      WT_ERR = 3
    ENDIF
  ENDIF

  ; a corner needs room on both of its seams, otherwise the approach and
  ; departure points would run past the neighbouring point
  IF WT_ERR == 0 THEN
    FOR i = 2 TO WT_NPT - 1
      IF WT_PT[i].CPRE >= PosDist(WT_PT[i-1].P,WT_PT[i].P) THEN
        WT_ERR = 7
      ENDIF
      IF WT_PT[i].CPOST >= PosDist(WT_PT[i].P,WT_PT[i+1].P) THEN
        WT_ERR = 7
      ENDIF
    ENDFOR
  ENDIF

  IF WT_ERR <> 0 THEN
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    RETURN
  ENDIF

  TC_ERR_CODE = 0
  TC_TASK_STATE = 2
  TC_TASK_BUSY = TRUE
  TC_PROGRESS = 0

  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  SetPtpDyn()
  $APO.CDIS = 0.0

  ; TC_SEAM_COUNT 0 is a positioning command, no arc
  IF WT_NSEAM == 0 THEN
    MoveToPoint(1)
    TC_TASK_BUSY = FALSE
    TC_TASK_STATE = 4
    TC_PROGRESS = 10000
    RETURN
  ENDIF

  ; approach above point 1, along the negative local Z of the torch
  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  fOff.Z = -WT_APPROACH
  pTgt = WT_PT[1].P : fOff
  PTP pTgt

  SetAirSpeed()
  pTgt = WT_PT[1].P
  LIN pTgt

  TC_TASK_STATE = 3
  ArcOn(1)
  IF WT_ERR <> 0 THEN
    ArcOff()
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 5
    TC_TASK_BUSY = FALSE
    TC_SEG_ACTIVE = 0
    RETURN
  ENDIF

  WeldChain()

  ArcOff()
  TC_PROGRESS = 10000

  ; retract along the negative local Z of the torch
  SetAirSpeed()
  fOff.Z = -WT_APPROACH
  pTgt = WT_PT[WT_NPT].P : fOff
  LIN pTgt

  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  TC_TASK_STATE = 4
END

DEF WeldChain()
  ; the arc stays on from point 1 to the last point. Each seam is welded up
  ; to the corner approach point, the corner itself is traversed with a
  ; limited reorientation speed, and the next seam starts at the corner
  ; departure point.
  DECL INT i
  DECL REAL rLen
  DECL REAL rF
  DECL E6POS pCur
  DECL E6POS pTgt

  pCur = WT_PT[1].P

  FOR i = 1 TO WT_NSEAM
    TC_SEG_ACTIVE = i
    TC_PROGRESS = ((i - 1) * 10000) / WT_NSEAM
    SetSegProc(i)

    pTgt = WT_PT[i+1].P
    IF i < WT_NSEAM THEN
      rLen = PosDist(WT_PT[i].P,WT_PT[i+1].P)
      IF (WT_PT[i+1].CPRE > 0.1) AND (rLen > WT_PT[i+1].CPRE) THEN
        rF = 1.0 - (WT_PT[i+1].CPRE / rLen)
        LerpPos(WT_PT[i].P,WT_PT[i+1].P,rF,pTgt)
      ENDIF
    ENDIF
    WeldLine(i,pCur,pTgt)
    pCur = pTgt

    IF i < WT_NSEAM THEN
      SetCornerProc(i+1)
      pTgt = WT_PT[i+1].P
      LIN pTgt
      pCur = pTgt
      IF WT_PT[i+1].CDWELL > 0.01 THEN
        WAIT SEC WT_PT[i+1].CDWELL
      ENDIF
      rLen = PosDist(WT_PT[i+1].P,WT_PT[i+2].P)
      IF (WT_PT[i+1].CPOST > 0.1) AND (rLen > WT_PT[i+1].CPOST) THEN
        rF = WT_PT[i+1].CPOST / rLen
        LerpPos(WT_PT[i+1].P,WT_PT[i+2].P,rF,pTgt)
        LIN pTgt
        pCur = pTgt
      ENDIF
    ENDIF
  ENDFOR

  ; crater fill, weld back along the last seam before the arc goes off
  IF WT_CRATER > 0.1 THEN
    rLen = PosDist(WT_PT[WT_NPT-1].P,WT_PT[WT_NPT].P)
    IF rLen > WT_CRATER THEN
      rF = 1.0 - (WT_CRATER / rLen)
      LerpPos(WT_PT[WT_NPT-1].P,WT_PT[WT_NPT].P,rF,pTgt)
      LIN pTgt
    ENDIF
  ENDIF
END

DEF MoveToPoint(nP:IN)
  ; RS_STEP_MODE decides how the point is reached. Mode 3 reads the X..C
  ; fields as axis angles, which is how a joint target is sent now that
  ; RobotSendRobot no longer has SJ1..SJ6.
  DECL INT nP
  DECL E6POS pTgt
  DECL E6AXIS aTgt

  SWITCH WT_STEP
  CASE 3
    aTgt.A1 = WT_PT[nP].P.X
    aTgt.A2 = WT_PT[nP].P.Y
    aTgt.A3 = WT_PT[nP].P.Z
    aTgt.A4 = WT_PT[nP].P.A
    aTgt.A5 = WT_PT[nP].P.B
    aTgt.A6 = WT_PT[nP].P.C
    aTgt.E1 = WT_PT[nP].P.E1
    aTgt.E2 = WT_PT[nP].P.E2
    aTgt.E3 = WT_PT[nP].P.E3
    aTgt.E4 = $AXIS_ACT.E4
    aTgt.E5 = $AXIS_ACT.E5
    aTgt.E6 = $AXIS_ACT.E6
    PTP aTgt
  CASE 2
    SetAirSpeed()
    pTgt = WT_PT[nP].P
    LIN pTgt
  DEFAULT
    pTgt = WT_PT[nP].P
    PTP pTgt
  ENDSWITCH
END

DEF GoHome()
  IF TC_TASK_BUSY THEN
    RETURN
  ENDIF
  SetPtpDyn()
  PTP XHOME
END

DEF TaskAbort()
  INTERRUPT OFF 25
  BRAKE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  TC_ARC_ON = FALSE
  WT_ABORTED = TRUE
  WT_ERR = 5
  TC_ERR_CODE = 5
  TC_TASK_STATE = 5
  TC_SEG_ACTIVE = 0
  TC_TASK_BUSY = FALSE
  RESUME
END

;==================================
; Motion and process
;==================================

DEF WeldLine(nS:IN,pA:IN,pB:IN)
  DECL INT nS
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pW
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL INT nSteps
  DECL INT i
  DECL REAL rLen
  DECL REAL rHalf
  DECL REAL rF
  DECL REAL rAmp

  rLen = PosDist(pA,pB)
  rAmp = WT_SEG[nS].AMP

  IF NOT(WT_SEG[nS].WEAVE) OR (rAmp < 0.1) OR (WT_SEG[nS].FREQ < 0.1) OR (rLen < 1.0) THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  ; half a weave period expressed in mm of travel
  rHalf = WT_SEG[nS].SPEED / (2.0 * WT_SEG[nS].FREQ)
  IF rHalf < 0.5 THEN
    rHalf = 0.5
  ENDIF
  nSteps = rLen / rHalf
  IF nSteps < 2 THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  ; the weave is a local Y offset of the point frame, so the PC must send
  ; orientations whose local X runs along the travel direction
  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  $APO.CDIS = rAmp * 0.5
  FOR i = 1 TO nSteps - 1
    rF = i
    rF = rF / nSteps
    LerpPos(pA,pB,rF,pW)
    IF (i - (i / 2) * 2) == 1 THEN
      fOff.Y = rAmp
    ELSE
      fOff.Y = -rAmp
    ENDIF
    pTgt = pW : fOff
    LIN pTgt C_DIS
  ENDFOR
  $APO.CDIS = 0.0
  pTgt = pB
  LIN pTgt
END

DEF SetPtpDyn()
  DECL INT nV
  DECL INT nA

  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)

  IF (WT_EXSPEED >= 1.0) AND (WT_EXSPEED <= 100.0) THEN
    RedVelExAx[1] = WT_EXSPEED
    RedVelExAx[2] = WT_EXSPEED
    RedVelExAx[3] = WT_EXSPEED
  ENDIF
  IF (WT_EXACC >= 1.0) AND (WT_EXACC <= 100.0) THEN
    RedAccExAx[1] = WT_EXACC
    RedAccExAx[2] = WT_EXACC
    RedAccExAx[3] = WT_EXACC
  ENDIF
END

DEF SetAirSpeed()
  DECL REAL rV

  rV = WT_AIRSPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.001
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
END

DEF SetSegProc(nS:IN)
  DECL INT nS
  DECL REAL rV

  rV = WT_SEG[nS].SPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.001
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0

  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
END

DEF SetCornerProc(nP:IN)
  DECL INT nP
  DECL REAL rOri

  ; rpm to deg/s
  rOri = WT_PT[nP].CROT * 6.0
  IF rOri < 1.0 THEN
    rOri = 1.0
  ENDIF
  IF rOri > 200.0 THEN
    rOri = 200.0
  ENDIF
  $VEL.ORI1 = rOri
  $VEL.ORI2 = rOri
END

DEF ArcOn(nS:IN)
  DECL INT nS

  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
  WT_GAS_REQ = TRUE
  WAIT SEC 0.3
  WT_ARC_REQ = TRUE
  TC_ARC_ON = TRUE

  $TIMER_STOP[21] = TRUE
  $TIMER[21] = 0
  $TIMER_STOP[21] = FALSE
  WAIT FOR (DI_ArcStability) OR ($TIMER[21] > 3000)
  $TIMER_STOP[21] = TRUE
  IF NOT(DI_ArcStability) THEN
    WT_ERR = 4
  ENDIF
END

DEF ArcOff()
  WT_ARC_REQ = FALSE
  TC_ARC_ON = FALSE
  WAIT SEC 0.3
  WT_GAS_REQ = FALSE
END

;==================================
; Geometry helpers
;==================================

DEF LerpPos(pA:IN,pB:IN,rF:IN,pR:OUT)
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pR
  DECL REAL rF

  pR = pA
  pR.X = pA.X + (pB.X - pA.X) * rF
  pR.Y = pA.Y + (pB.Y - pA.Y) * rF
  pR.Z = pA.Z + (pB.Z - pA.Z) * rF
  pR.A = pA.A + (pB.A - pA.A) * rF
  pR.B = pA.B + (pB.B - pA.B) * rF
  pR.C = pA.C + (pB.C - pA.C) * rF
  pR.E1 = pA.E1 + (pB.E1 - pA.E1) * rF
  pR.E2 = pA.E2 + (pB.E2 - pA.E2) * rF
  pR.E3 = pA.E3 + (pB.E3 - pA.E3) * rF
END

DEFFCT REAL PosDist(pA:IN,pB:IN)
  DECL E6POS pA
  DECL E6POS pB
  DECL REAL dx
  DECL REAL dy
  DECL REAL dz

  dx = pB.X - pA.X
  dy = pB.Y - pA.Y
  dz = pB.Z - pA.Z
  RETURN SQRT(dx * dx + dy * dy + dz * dz)
ENDFCT
