&ACCESS RV
&REL 4
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF pc2kuka( )

  ; $IN[3025]..$IN[4048] image. RS_CMD 1 joint, 2 weld, 3..4 weld run/clear, 5..7 traj.
  ; Latch on RS_TOGGLE edge. EWM_* outputs are written only in sps.sub.

  DECL INT nCmd

  BAS(#INITMOV,0)
  $APO.CDIS = 0.0
  $APO.CPTP = 0
  $ADVANCE = 3

  WT_TASK_ID = 0
  WT_NPT = 0
  WT_TOOL = 1
  WT_BASE = 0
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  WT_ERR = 0
  WT_SAMPLES = 0
  WT_ABORTED = FALSE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  WT_TASK_READY = FALSE
  WT_JTRAJ_N = 0
  ClearTask()

  TC_ACK_CMD = 0
  TC_TRAJ_POINTS = 0
  TC_ACK_TASK_ID = 0
  TC_ACK_FRAME_NO = 0
  TC_TASK_STATE = 0
  TC_ERR_CODE = 0
  TC_PROGRESS = 0
  TC_TASK_BUSY = FALSE
  TC_ARC_ON = FALSE
  TC_ACK_TOGGLE = RS_TOGGLE

  INTERRUPT DECL 25 WHEN RS_ABORT==TRUE DO TaskAbort()
  INTERRUPT ON 25

  LOOP
    IF WT_ABORTED THEN
      WAIT FOR NOT(RS_ABORT)
      WT_ABORTED = FALSE
      INTERRUPT ON 25
    ENDIF

    WAIT FOR (RS_TOGGLE <> TC_ACK_TOGGLE) OR RS_RESET OR RS_GOTO_HOME
    IF WT_ABORTED THEN
      CONTINUE
    ENDIF

    IF RS_RESET THEN
      WT_ERR = 0
      TC_ERR_CODE = 0
      IF TC_TASK_STATE == 4 THEN
        TC_TASK_STATE = 0
      ENDIF
      WAIT FOR NOT(RS_RESET)
      CONTINUE
    ENDIF

    IF RS_GOTO_HOME THEN
      GoHome()
      WAIT FOR NOT(RS_GOTO_HOME)
      CONTINUE
    ENDIF

    nCmd = RS_CMD
    SWITCH nCmd
    CASE 1
      JointMove()
    CASE 2
      ReadWeldSetup()
    CASE 3
      TaskExec()
    CASE 4
      ClearTask()
      WT_TASK_ID = 0
      WT_NPT = 0
      WT_TASK_READY = FALSE
      WT_ERR = 0
      TC_ERR_CODE = 0
      TC_TASK_STATE = 0
    CASE 5
      JointTrajAppend()
    CASE 6
      JointTrajRun()
    CASE 7
      JointTrajClear()
    DEFAULT
      WT_ERR = 6
      TC_ERR_CODE = 6
      TC_TASK_STATE = 4
    ENDSWITCH

    TC_ACK_CMD = nCmd
    TC_ACK_TASK_ID = WT_TASK_ID
    TC_ACK_FRAME_NO = RS_FRAME_NO
    TC_ACK_TOGGLE = RS_TOGGLE
  ENDLOOP

END

DEF ClearTask()
  WT_PT[1].PVALID = FALSE
  WT_PT[2].PVALID = FALSE
  WT_SEG[1].SVALID = FALSE
  WT_SEG[1].SPEED = 0.0
  WT_SEG[1].AMP = 0.0
  WT_SEG[1].FREQ = 0.0
  WT_SEG[1].WEAVE = 0
  WT_SEG[1].JOB = 0
  WT_SEG[1].WIRE = 0
  WT_SEG[1].VOLT = 0
  WT_SEG[1].DYN = 0
  WT_SAMPLES = 0
  WT_TASK_READY = FALSE
  TC_PROGRESS = 0
END

DEF LatchPose(nI:IN)
  DECL INT nI

  WT_PT[nI].P.E1 = $AXIS_ACT.E1
  WT_PT[nI].P.E2 = $AXIS_ACT.E2
  WT_PT[nI].P.E3 = $AXIS_ACT.E3
  WT_PT[nI].P.E4 = $AXIS_ACT.E4
  WT_PT[nI].P.E5 = $AXIS_ACT.E5
  WT_PT[nI].P.E6 = $AXIS_ACT.E6
  WT_PT[nI].P.S = $POS_ACT.S
  WT_PT[nI].P.T = $POS_ACT.T
  WT_PT[nI].PVALID = TRUE
END

DEF ReadWeldSetup()
  ClearTask()
  WT_TASK_ID = RS_TASK_ID
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  WT_NPT = 2
  WT_ERR = 0

  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF

  WT_PT[1].P.X = BitsToReal(WS_P1_X)
  WT_PT[1].P.Y = BitsToReal(WS_P1_Y)
  WT_PT[1].P.Z = BitsToReal(WS_P1_Z)
  WT_PT[1].P.A = BitsToReal(WS_P1_A)
  WT_PT[1].P.B = BitsToReal(WS_P1_B)
  WT_PT[1].P.C = BitsToReal(WS_P1_C)
  LatchPose(1)

  WT_PT[2].P.X = BitsToReal(WS_P2_X)
  WT_PT[2].P.Y = BitsToReal(WS_P2_Y)
  WT_PT[2].P.Z = BitsToReal(WS_P2_Z)
  WT_PT[2].P.A = BitsToReal(WS_P2_A)
  WT_PT[2].P.B = BitsToReal(WS_P2_B)
  WT_PT[2].P.C = BitsToReal(WS_P2_C)
  LatchPose(2)

  WT_SEG[1].SPEED = BitsToReal(WS_SPEED)
  WT_SEG[1].AMP = BitsToReal(WS_AMP)
  WT_SEG[1].FREQ = BitsToReal(WS_FREQ)
  WT_SEG[1].WEAVE = WS_WEAVE
  WT_SEG[1].JOB = WS_JOB
  WT_SEG[1].WIRE = WS_WIRE
  WT_SEG[1].VOLT = WS_VOLT
  WT_SEG[1].DYN = WS_DYN
  WT_SEG[1].SVALID = TRUE

  WT_CRATER = BitsToReal(WS_CRATER)
  WT_APPROACH = BitsToReal(WS_APPROACH)
  WT_AIRSPEED = BitsToReal(WS_AIRSPEED)
  WT_AXSPEED = BitsToReal(WS_AXSPEED)
  WT_AXACC = BitsToReal(WS_AXACC)
  WT_EXSPEED = BitsToReal(WS_EXSPEED)
  WT_EXACC = BitsToReal(WS_EXACC)
  WT_SAMPLES = WS_SAMPLES

  IF (WT_SEG[1].WEAVE < 0) OR (WT_SEG[1].WEAVE > 2) THEN
    WT_ERR = 9
    TC_ERR_CODE = 9
    TC_TASK_STATE = 4
    RETURN
  ENDIF

  WT_TASK_READY = TRUE
  TC_ERR_CODE = 0
  TC_TASK_STATE = 1
END

DEF ApplyFrame()
  IF (RS_TOOL_ID < 1) OR (RS_TOOL_ID > 16) OR (RS_BASE_ID < 0) OR (RS_BASE_ID > 32) THEN
    WT_ERR = 3
    TC_ERR_CODE = 3
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  WT_TOOL = RS_TOOL_ID
  WT_BASE = RS_BASE_ID
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  WT_ERR = 0
END

DEF RequireEnable()
  IF NOT(RS_ENABLE) THEN
    WT_ERR = 8
    TC_ERR_CODE = 8
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  WT_ERR = 0
END

DEF JointMove()
  DECL E6AXIS aTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  SetJointDyn()
  aTgt.A1 = BitsToReal(RJ_A1)
  aTgt.A2 = BitsToReal(RJ_A2)
  aTgt.A3 = BitsToReal(RJ_A3)
  aTgt.A4 = BitsToReal(RJ_A4)
  aTgt.A5 = BitsToReal(RJ_A5)
  aTgt.A6 = BitsToReal(RJ_A6)
  aTgt.E1 = BitsToReal(RJ_E1)
  aTgt.E2 = BitsToReal(RJ_E2)
  aTgt.E3 = BitsToReal(RJ_E3)
  aTgt.E4 = $AXIS_ACT.E4
  aTgt.E5 = $AXIS_ACT.E5
  aTgt.E6 = $AXIS_ACT.E6
  $APO.CPTP = 0
  PTP aTgt
  TC_ERR_CODE = 0
  WT_ERR = 0
  IF TC_TASK_STATE == 4 THEN
    TC_TASK_STATE = 0
  ENDIF
END

DEF JointTrajAppend()
  DECL E6AXIS aTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF RS_FRAME_NO == 1 THEN
    WT_JTRAJ_N = 0
  ENDIF
  IF WT_JTRAJ_N >= WT_JTRAJ_MAX THEN
    WT_ERR = 11
    TC_ERR_CODE = 11
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  ApplyFrame()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  SetJointDyn()
  aTgt.A1 = BitsToReal(RJ_A1)
  aTgt.A2 = BitsToReal(RJ_A2)
  aTgt.A3 = BitsToReal(RJ_A3)
  aTgt.A4 = BitsToReal(RJ_A4)
  aTgt.A5 = BitsToReal(RJ_A5)
  aTgt.A6 = BitsToReal(RJ_A6)
  aTgt.E1 = BitsToReal(RJ_E1)
  aTgt.E2 = BitsToReal(RJ_E2)
  aTgt.E3 = BitsToReal(RJ_E3)
  aTgt.E4 = $AXIS_ACT.E4
  aTgt.E5 = $AXIS_ACT.E5
  aTgt.E6 = $AXIS_ACT.E6
  WT_JTRAJ_N = WT_JTRAJ_N + 1
  WT_JTRAJ[WT_JTRAJ_N] = aTgt
  TC_TRAJ_POINTS = WT_JTRAJ_N
  TC_ERR_CODE = 0
  WT_ERR = 0
  TC_PROGRESS = 0
  IF TC_TASK_STATE == 4 THEN
    TC_TASK_STATE = 0
  ENDIF
END

DEF JointTrajRun()
  DECL INT i
  DECL INT nBlend

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF TC_TASK_BUSY THEN
    RETURN
  ENDIF
  IF WT_JTRAJ_N < 1 THEN
    WT_ERR = 10
    TC_ERR_CODE = 10
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  IF RS_CONT THEN
    nBlend = 80
  ELSE
    nBlend = 0
  ENDIF
  TC_TASK_BUSY = TRUE
  TC_TASK_STATE = 2
  TC_PROGRESS = 0
  SetStoredPtp()
  FOR i = 1 TO WT_JTRAJ_N
    TC_PROGRESS = ((i - 1) * 10000) / WT_JTRAJ_N
    IF (RS_CONT) AND (i < WT_JTRAJ_N) THEN
      $APO.CPTP = nBlend
      PTP WT_JTRAJ[i] C_PTP
    ELSE
      $APO.CPTP = 0
      PTP WT_JTRAJ[i]
    ENDIF
  ENDFOR
  WT_JTRAJ_N = 0
  TC_TRAJ_POINTS = 0
  TC_PROGRESS = 10000
  TC_TASK_BUSY = FALSE
  TC_TASK_STATE = 3
  TC_ERR_CODE = 0
  WT_ERR = 0
END

DEF JointTrajClear()
  WT_JTRAJ_N = 0
  TC_TRAJ_POINTS = 0
  TC_PROGRESS = 0
  TC_ERR_CODE = 0
  WT_ERR = 0
  IF TC_TASK_STATE == 4 THEN
    TC_TASK_STATE = 0
  ENDIF
END

DEF GoHome()
  DECL INT nV
  DECL INT nA

  IF TC_TASK_BUSY THEN
    RETURN
  ENDIF
  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  $APO.CPTP = 0
  PTP XHOME
  TC_ERR_CODE = 0
END

DEF TaskExec()
  DECL E6POS pTgt

  RequireEnable()
  IF WT_ERR <> 0 THEN
    RETURN
  ENDIF
  IF NOT(WT_TASK_READY) THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  IF NOT(WT_PT[1].PVALID) OR NOT(WT_PT[2].PVALID) OR NOT(WT_SEG[1].SVALID) THEN
    WT_ERR = 2
    TC_ERR_CODE = 2
    TC_TASK_STATE = 4
    RETURN
  ENDIF
  IF (WT_TOOL < 1) OR (WT_TOOL > 16) OR (WT_BASE < 0) OR (WT_BASE > 32) THEN
    WT_ERR = 3
    TC_ERR_CODE = 3
    TC_TASK_STATE = 4
    RETURN
  ENDIF

  TC_ERR_CODE = 0
  TC_TASK_STATE = 2
  TC_TASK_BUSY = TRUE
  TC_PROGRESS = 0
  BAS(#TOOL,WT_TOOL)
  BAS(#BASE,WT_BASE)
  SetStoredPtp()
  $APO.CDIS = 0.0

  IF WT_APPROACH > 1.0 THEN
    TorchShift(WT_PT[1].P,-WT_APPROACH,1)
  ENDIF
  SetAirSpeed()
  pTgt = WT_PT[1].P
  LIN pTgt

  TC_TASK_STATE = 2
  ArcOn(1)
  IF WT_ERR <> 0 THEN
    ArcOff()
    TC_ERR_CODE = WT_ERR
    TC_TASK_STATE = 4
    TC_TASK_BUSY = FALSE
    RETURN
  ENDIF

  WeldSeam()
  ArcOff()
  TC_PROGRESS = 10000
  SetAirSpeed()
  IF WT_APPROACH > 1.0 THEN
    TorchShift(WT_PT[2].P,-WT_APPROACH,0)
  ENDIF
  IF WT_CRATER > 0.1 THEN
    CraterFill()
  ENDIF
  TC_TASK_BUSY = FALSE
  TC_TASK_STATE = 3
END

DEF CraterFill()
  DECL E6POS pTgt
  DECL REAL rLen
  DECL REAL rF

  rLen = PosDist(WT_PT[1].P,WT_PT[2].P)
  IF rLen > WT_CRATER THEN
    rF = 1.0 - (WT_CRATER / rLen)
    LerpPos(WT_PT[1].P,WT_PT[2].P,rF,pTgt)
    LIN pTgt
  ENDIF
END

DEF WeldSeam()
  SetSegProc(1)
  TC_PROGRESS = 5000
  WeldLine(1,WT_PT[1].P,WT_PT[2].P)
END

DEF TaskAbort()
  INTERRUPT OFF 25
  BRAKE
  WT_ARC_REQ = FALSE
  WT_GAS_REQ = FALSE
  TC_ARC_ON = FALSE
  WT_ABORTED = TRUE
  WT_ERR = 5
  TC_ERR_CODE = 5
  TC_TASK_STATE = 4
  TC_TASK_BUSY = FALSE
  RESUME
END

DEF WeldLine(nS:IN,pA:IN,pB:IN)
  DECL INT nS
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pW
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL INT nPer
  DECL INT nSteps
  DECL INT nIn
  DECL INT i
  DECL REAL rLen
  DECL REAL rPeriod
  DECL REAL rF
  DECL REAL rU
  DECL REAL rAmp
  DECL REAL rStep

  $APO.CDIS = 0.0
  rLen = PosDist(pA,pB)
  rAmp = WT_SEG[nS].AMP
  IF (WT_SEG[nS].WEAVE == 0) OR (rAmp < 0.1) OR (WT_SEG[nS].FREQ < 0.1) OR (rLen < 1.0) THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  nPer = WT_SAMPLES
  IF (nPer < 2) OR (nPer > 32) THEN
    IF WT_SEG[nS].WEAVE == 1 THEN
      nPer = 4
    ELSE
      nPer = 8
    ENDIF
  ENDIF
  rPeriod = WT_SEG[nS].SPEED / WT_SEG[nS].FREQ
  IF rPeriod < 0.5 THEN
    rPeriod = 0.5
  ENDIF
  rStep = nPer
  rStep = rPeriod / rStep
  nSteps = rLen / rStep
  IF nSteps > 400 THEN
    nSteps = 400
  ENDIF
  IF nSteps < 2 THEN
    pTgt = pB
    LIN pTgt
    RETURN
  ENDIF

  rStep = nSteps
  rStep = rLen / rStep
  IF WT_SEG[nS].WEAVE == 2 THEN
    $APO.CDIS = rStep * 0.8
  ELSE
    $APO.CDIS = rStep * 0.25
  ENDIF
  IF $APO.CDIS < 0.2 THEN
    $APO.CDIS = 0.2
  ENDIF

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  FOR i = 1 TO nSteps - 1
    rF = i
    rF = rF / nSteps
    LerpPos(pA,pB,rF,pW)
    nIn = (i - 1) - ((i - 1) / nPer) * nPer
    rU = nIn
    rU = rU / nPer
    fOff.Y = WeaveY(WT_SEG[nS].WEAVE,rAmp,rU)
    pTgt = pW : fOff
    LIN pTgt C_DIS
  ENDFOR
  $APO.CDIS = 0.0
  pTgt = pB
  LIN pTgt
END

DEFFCT REAL WeaveY(nMode:IN,rAmp:IN,rU:IN)
  DECL INT nMode
  DECL REAL rAmp
  DECL REAL rU
  DECL REAL rY

  IF nMode == 2 THEN
    RETURN (rAmp * SIN(rU * 360.0))
  ENDIF
  IF rU < 0.25 THEN
    rY = rU / 0.25
  ELSE
    IF rU < 0.75 THEN
      rY = 1.0 - ((rU - 0.25) / 0.25)
    ELSE
      rY = -1.0 + ((rU - 0.75) / 0.25)
    ENDIF
  ENDIF
  RETURN (rAmp * rY)
ENDFCT

DEF TorchShift(pFrom:IN,rZ:IN,nPtp:IN)
  DECL E6POS pFrom
  DECL E6POS pTgt
  DECL FRAME fOff
  DECL REAL rZ
  DECL INT nPtp

  fOff = {X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0}
  fOff.Z = rZ
  pTgt = pFrom : fOff
  IF nPtp == 1 THEN
    PTP pTgt
  ELSE
    LIN pTgt
  ENDIF
END

DEF SetJointDyn()
  DECL REAL rV
  DECL INT nV
  DECL INT nA

  rV = BitsToReal(RJ_AXIS_SPEED)
  nV = rV
  rV = BitsToReal(RJ_AXIS_ACC)
  nA = rV
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  WT_AXSPEED = nV
  WT_AXACC = nA
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  rV = BitsToReal(RJ_EXT_SPEED)
  IF (rV >= 1.0) AND (rV <= 100.0) THEN
    WT_EXSPEED = rV
    RedVelExAx[1] = rV
    RedVelExAx[2] = rV
    RedVelExAx[3] = rV
  ENDIF
  rV = BitsToReal(RJ_EXT_ACC)
  IF (rV >= 1.0) AND (rV <= 100.0) THEN
    WT_EXACC = rV
    RedAccExAx[1] = rV
    RedAccExAx[2] = rV
    RedAccExAx[3] = rV
  ENDIF
END

DEF SetStoredPtp()
  DECL INT nV
  DECL INT nA

  nV = WT_AXSPEED
  nA = WT_AXACC
  IF (nV < 1) OR (nV > 100) THEN
    nV = 30
  ENDIF
  IF (nA < 1) OR (nA > 100) THEN
    nA = 50
  ENDIF
  BAS(#VEL_PTP,nV)
  BAS(#ACC_PTP,nA)
  IF (WT_EXSPEED >= 1.0) AND (WT_EXSPEED <= 100.0) THEN
    RedVelExAx[1] = WT_EXSPEED
    RedVelExAx[2] = WT_EXSPEED
    RedVelExAx[3] = WT_EXSPEED
  ENDIF
  IF (WT_EXACC >= 1.0) AND (WT_EXACC <= 100.0) THEN
    RedAccExAx[1] = WT_EXACC
    RedAccExAx[2] = WT_EXACC
    RedAccExAx[3] = WT_EXACC
  ENDIF
END

DEF SetAirSpeed()
  DECL REAL rV

  rV = WT_AIRSPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.05
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
END

DEF SetSegProc(nS:IN)
  DECL INT nS
  DECL REAL rV

  rV = WT_SEG[nS].SPEED / 1000.0
  IF rV < 0.001 THEN
    rV = 0.001
  ENDIF
  IF rV > 2.0 THEN
    rV = 2.0
  ENDIF
  $VEL.CP = rV
  $ACC.CP = 2.3
  $VEL.ORI1 = 200.0
  $VEL.ORI2 = 200.0
  $ACC.ORI1 = 100.0
  $ACC.ORI2 = 100.0
  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
END

DEF ArcOn(nS:IN)
  DECL INT nS

  WT_ACT_JOB = WT_SEG[nS].JOB
  WT_ACT_WIRE = WT_SEG[nS].WIRE
  WT_ACT_VOLT = WT_SEG[nS].VOLT
  WT_ACT_DYN = WT_SEG[nS].DYN
  WT_GAS_REQ = TRUE
  WAIT SEC 0.3
  WT_ARC_REQ = TRUE
  TC_ARC_ON = TRUE
  $TIMER_STOP[21] = TRUE
  $TIMER[21] = 0
  $TIMER_STOP[21] = FALSE
  WAIT FOR (DI_ArcStability) OR ($TIMER[21] > 3000)
  $TIMER_STOP[21] = TRUE
  IF NOT(DI_ArcStability) THEN
    WT_ERR = 4
  ENDIF
END

DEF ArcOff()
  WT_ARC_REQ = FALSE
  TC_ARC_ON = FALSE
  WAIT SEC 0.3
  WT_GAS_REQ = FALSE
END

DEF LerpPos(pA:IN,pB:IN,rF:IN,pR:OUT)
  DECL E6POS pA
  DECL E6POS pB
  DECL E6POS pR
  DECL REAL rF

  pR = pA
  pR.X = pA.X + (pB.X - pA.X) * rF
  pR.Y = pA.Y + (pB.Y - pA.Y) * rF
  pR.Z = pA.Z + (pB.Z - pA.Z) * rF
  pR.A = pA.A + (pB.A - pA.A) * rF
  pR.B = pA.B + (pB.B - pA.B) * rF
  pR.C = pA.C + (pB.C - pA.C) * rF
  pR.E1 = pA.E1 + (pB.E1 - pA.E1) * rF
  pR.E2 = pA.E2 + (pB.E2 - pA.E2) * rF
  pR.E3 = pA.E3 + (pB.E3 - pA.E3) * rF
END

DEFFCT REAL PosDist(pA:IN,pB:IN)
  DECL E6POS pA
  DECL E6POS pB
  DECL REAL dx
  DECL REAL dy
  DECL REAL dz

  dx = pB.X - pA.X
  dy = pB.Y - pA.Y
  dz = pB.Z - pA.Z
  RETURN SQRT(dx * dx + dy * dy + dz * dz)
ENDFCT